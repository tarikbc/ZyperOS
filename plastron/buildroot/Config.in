config BR2_PLASTRON_DEVICE
	string "ZyperOS device"
	default "pixel2"
	help
	  The handheld this system is for, by ZyperOS's device id
	  ("pixel2", "brick"): its build as ZyperOS states it, in
	  config/device/<id>.mk (from src/device/<id>_build.c), which the
	  packages read for the device's Diatom port, splash, payload and
	  /etc/zyperos/system. QEMU's system is the Pixel 2's.

source "$BR2_EXTERNAL_PX2_PATH/package/splash/Config.in"
source "$BR2_EXTERNAL_PX2_PATH/package/mesa3d-px2/Config.in"
source "$BR2_EXTERNAL_PX2_PATH/package/powerkey/Config.in"
source "$BR2_EXTERNAL_PX2_PATH/package/jackswitch/Config.in"
source "$BR2_EXTERNAL_PX2_PATH/package/zyperos-eq/Config.in"
source "$BR2_EXTERNAL_PX2_PATH/package/zyperos/Config.in"
source "$BR2_EXTERNAL_PX2_PATH/package/diatom/Config.in"
source "$BR2_EXTERNAL_PX2_PATH/package/usbrole/Config.in"
source "$BR2_EXTERNAL_PX2_PATH/package/usbdrive/Config.in"
source "$BR2_EXTERNAL_PX2_PATH/package/gauge/Config.in"
source "$BR2_EXTERNAL_PX2_PATH/package/hwdog/Config.in"
source "$BR2_EXTERNAL_PX2_PATH/package/px2sim/Config.in"
source "$BR2_EXTERNAL_PX2_PATH/package/pvr-ge8300/Config.in"
source "$BR2_EXTERNAL_PX2_PATH/package/xr829-firmware/Config.in"
source "$BR2_EXTERNAL_PX2_PATH/package/brick-kmods/Config.in"
source "$BR2_EXTERNAL_PX2_PATH/package/brick-tools/Config.in"
source "$BR2_EXTERNAL_PX2_PATH/package/brick-rootswitch/Config.in"
