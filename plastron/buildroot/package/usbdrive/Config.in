config BR2_PACKAGE_USBDRIVE
	bool "usbdrive"
	select BR2_PACKAGE_LIBDRM
	help
	  The games partition as a USB drive (configfs f_mass_storage) for
	  ZyperOS's Computer Connected > USB Drive: the card unmounted first,
	  exported until the computer ejects it or the cable comes out, then
	  checked, mounted again and ZyperOS started again. Never exported
	  while mounted.
