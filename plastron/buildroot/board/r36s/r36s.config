# The R36S's changes to the ZyperOS image's config (board/zyperos/
# zyperos.config), merged after it by scripts/build.sh for FLAVOR=r36s: its
# own overlay after the Pixel 2's and ZyperOS's (the games partition's
# report in its folder).
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PX2_PATH)/board/px2/rootfs-overlay $(BR2_EXTERNAL_PX2_PATH)/board/zyperos/rootfs-overlay $(BR2_EXTERNAL_PX2_PATH)/board/r36s/rootfs-overlay"
