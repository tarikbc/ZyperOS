# ZyperOS's image for QEMU: merged after board/zyperos/zyperos.config by
# scripts/build.sh (FLAVOR=qemu), on configs/qemu_defconfig.

# The three overlays, the virt machine's last, so its inittab and datapart
# settings win over ZyperOS's
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PX2_PATH)/board/px2/rootfs-overlay $(BR2_EXTERNAL_PX2_PATH)/board/zyperos/rootfs-overlay $(BR2_EXTERNAL_PX2_PATH)/board/qemu/rootfs-overlay"

# No boot animation: its frames are made turned for the Pixel 2's portrait
# panel, and QEMU's display is landscape. ZyperOS's first frame is the first
# picture.
# BR2_PACKAGE_SPLASH is not set

# No USB Wi-Fi driver: zyperos.config adds Realtek's rtl8188eu for the Pixel
# 2's hotspot, and Buildroot's package turns on USB and the wireless stack in
# the kernel it builds against. The virt machine has no USB to plug an
# adapter into, so in QEMU that would only grow the kernel past
# board/qemu/linux.config. hostapd stays, finding no adapter, as on a Pixel 2
# with none plugged in.
# BR2_PACKAGE_RTL8188EU is not set
