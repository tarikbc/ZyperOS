From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: plastron
Date: Mon, 16 Nov 2026 12:00:00 -0300
Subject: [PATCH] The TrimUI Smart Pro (A133P, LPDDR4, AXP717): the Brick's
 board with its own memory, on top of board/brick/u-boot/patches. Its
 defconfig is the Brick's final one with the DRAM values TrimUI's boot0
 carries in its header for the Smart Pro (LPDDR4 at 792 MHz, mainline's
 SUNXI_DRAM_A133_LPDDR4 path, whose mode registers MR1-MR4 are boot0's
 already), DCDC3 at 1.1 V as boot0 sets it for LPDDR4 (it sets 1.2 V for
 the Brick's LPDDR3), and smartpro.dtb in the fallback boot command; its
 device tree is the Brick's with its own name

---
diff -Nru a/configs/trimui-smartpro_defconfig b/configs/trimui-smartpro_defconfig
--- a/configs/trimui-smartpro_defconfig
+++ b/configs/trimui-smartpro_defconfig
@@ -0,0 +1,62 @@
+CONFIG_ARM=y
+CONFIG_ARCH_SUNXI=y
+CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-a133-trimui-smartpro"
+CONFIG_DRAM_CLK=792
+CONFIG_SPL=y
+CONFIG_DRAM_SUNXI_DX_ODT=0x07070707
+CONFIG_DRAM_SUNXI_DX_DRI=0x0d0d0d0d
+CONFIG_DRAM_SUNXI_CA_DRI=0x0e0e
+CONFIG_DRAM_SUNXI_PARA0=0x0d0a050c
+CONFIG_DRAM_SUNXI_MR11=0x4
+CONFIG_DRAM_SUNXI_MR12=0x72
+CONFIG_DRAM_SUNXI_MR14=0x7
+CONFIG_DRAM_SUNXI_MR22=0x26
+CONFIG_DRAM_SUNXI_TPR0=0x06060606
+CONFIG_DRAM_SUNXI_TPR1=0x04040404
+CONFIG_DRAM_SUNXI_TPR6=0x48010101
+CONFIG_DRAM_SUNXI_TPR10=0x273333
+CONFIG_DRAM_SUNXI_TPR11=0x241f1923
+CONFIG_DRAM_SUNXI_TPR12=0x14151313
+CONFIG_DRAM_SUNXI_TPR13=0x81d20
+CONFIG_DRAM_SUNXI_TPR14=0x2023211f
+CONFIG_MACH_SUN50I_A133=y
+CONFIG_SUNXI_DRAM_A133_LPDDR4=y
+CONFIG_R_I2C_ENABLE=y
+CONFIG_ENV_VARS_UBOOT_CONFIG=y
+# CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
+# CONFIG_EFI_LOADER is not set
+# CONFIG_BOOTSTD is not set
+CONFIG_SUPPORT_RAW_INITRD=y
+# CONFIG_DISTRO_DEFAULTS is not set
+CONFIG_BOOTSTAGE=y
+CONFIG_BOOTSTAGE_RECORD_COUNT=60
+CONFIG_BOOTSTAGE_FDT=y
+CONFIG_BOOTDELAY=0
+CONFIG_USE_BOOTCOMMAND=y
+CONFIG_BOOTCOMMAND="if test -n ${fel_booted}; then source 0x43100000; fi; if load mmc 0:1 ${scriptaddr} boot.scr; then source ${scriptaddr}; fi; mw.l 0x03001128 0xd1303333; mw.l 0x03001160 0xc0014396; mw.l 0x03001178 0xc001eb85; mw.l 0x03001028 0xa9003100; mw.l 0x03001030 0xa8007403; mw.l 0x03001040 0xa8001803; mw.l 0x03001048 0xa8006203; mw.l 0x03001050 0xa8003701; mw.l 0x03001058 0xa8002301; mw.l 0x03001060 0xa9002401; mw.l 0x03001068 0xa8003101; mw.l 0x03001078 0xa9042701; if load mmc 0:1 ${kernel_addr_r} a/Image && load mmc 0:1 ${ramdisk_addr_r} a/initramfs.cpio.gz && setenv rdsize ${filesize} && load mmc 0:1 ${fdt_addr_r} a/smartpro.dtb; then fdt addr ${fdt_addr_r}; fdt resize 4096; fdt rsvmem add 0x40000000 0x40000; fdt set /soc@03000000/sdmmc@04022000 status disabled; setenv bootargs console=ttyS0,115200 loglevel=1 rdinit=/rdinit cma=64M; booti ${kernel_addr_r} ${ramdisk_addr_r}:${rdsize} ${fdt_addr_r}; fi"
+CONFIG_LAST_STAGE_INIT=y
+CONFIG_SPL_I2C=y
+CONFIG_HUSH_PARSER=y
+# CONFIG_CMD_UNZIP is not set
+CONFIG_CMD_BIND=y
+CONFIG_CMD_PART=y
+CONFIG_CMD_SYSBOOT=y
+CONFIG_CMD_EXT2=y
+CONFIG_CMD_FAT=y
+CONFIG_CMD_FS_GENERIC=y
+CONFIG_ISO_PARTITION=y
+CONFIG_ENV_IS_NOWHERE=y
+# CONFIG_NET is not set
+CONFIG_SPL_SYS_I2C_LEGACY=y
+CONFIG_SYS_I2C_MVTWSI=y
+CONFIG_SYS_I2C_SLAVE=0x7f
+CONFIG_SYS_I2C_SPEED=400000
+CONFIG_AXP717_POWER=y
+CONFIG_AXP_DCDC2_VOLT=900
+CONFIG_AXP_DCDC3_VOLT=1100
+CONFIG_BAUDRATE=1500000
+# CONFIG_USB is not set
+CONFIG_FAT_RENAME=y
+CONFIG_REGEX=y
+CONFIG_SPL_CRC8=y
+CONFIG_TOOLS_MKEFICAPSULE=y
diff -Nru a/dts/upstream/src/arm64/allwinner/sun50i-a133-trimui-smartpro.dts b/dts/upstream/src/arm64/allwinner/sun50i-a133-trimui-smartpro.dts
--- a/dts/upstream/src/arm64/allwinner/sun50i-a133-trimui-smartpro.dts
+++ b/dts/upstream/src/arm64/allwinner/sun50i-a133-trimui-smartpro.dts
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * TrimUI Smart Pro (A133P): the Brick's board in what U-Boot needs, the SD
+ * card, the PMIC and the serial port, as sun50i-a133-trimui-brick.dts. No
+ * regulator constraints here: SPL sets DCDC2 and DCDC3 (1.1 V, its LPDDR4's,
+ * where TrimUI's boot0 sets it) and the LDOs as on the Brick
+ * (board/sunxi/board.c). The internal eMMC is left out on purpose.
+ */
+
+/dts-v1/;
+
+#include "sun50i-a100.dtsi"
+
+/ {
+	model = "TrimUI Smart Pro";
+	compatible = "trimui,smart-pro", "allwinner,sun50i-a100";
+
+	aliases {
+		serial0 = &uart0;
+		mmc0 = &mmc0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+};
+
+&mmc0 {
+	bus-width = <4>;
+	broken-cd;
+	status = "okay";
+};
+
+&r_i2c0 {
+	status = "okay";
+
+	axp717: pmic@34 {
+		compatible = "x-powers,axp717";
+		reg = <0x34>;
+	};
+};
+
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_pb_pins>;
+	status = "okay";
+};
