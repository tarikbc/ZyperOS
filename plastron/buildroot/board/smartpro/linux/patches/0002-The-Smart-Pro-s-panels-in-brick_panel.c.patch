From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: plastron
Subject: [PATCH] The Smart Pro's panels in brick_panel.c, as its U-Boot tells
 them apart (LCD_BRICK_PANEL_SMARTPRO): the Brick's five shared ones, the
 axs1832 (0xda-0xdc 18 32 41) and the ft8756 (0x04 40, 0xda-0xdc 40 00 00)
 with their tables from TrimUI's Smart Pro U-Boot 1.1.1, its own nv3052 waits
 (250 and 250 ms where the Brick's are 220 and 120), no jd9168, and the
 otm1289a's commands for a panel that answers none of the IDs. The Brick's
 build is the same as before

---
diff -Nru a/drivers/video/fbdev/sunxi/disp2/disp/lcd/Kconfig b/drivers/video/fbdev/sunxi/disp2/disp/lcd/Kconfig
--- a/drivers/video/fbdev/sunxi/disp2/disp/lcd/Kconfig
+++ b/drivers/video/fbdev/sunxi/disp2/disp/lcd/Kconfig
@@ -29,6 +29,16 @@
 		The six panels the TrimUI Brick has been built with, told
 		apart by their IDs as TrimUI's U-Boot does.
 
+config LCD_BRICK_PANEL_SMARTPRO
+	bool "The TrimUI Smart Pro's set of them"
+	depends on LCD_SUPPORT_BRICK_PANEL
+	default n
+	---help---
+		The panels as the TrimUI Smart Pro's U-Boot tells them apart:
+		the Brick's but the jd9168, the axs1832 and the ft8756 besides,
+		its own waits for the nv3052, and the otm1289a's commands for a
+		panel that answers none of the IDs.
+
 config LCD_SUPPORT_HE0801A068
 	bool "LCD support he0801a068 panel"
 	default y
diff -Nru a/drivers/video/fbdev/sunxi/disp2/disp/lcd/brick_panel.c b/drivers/video/fbdev/sunxi/disp2/disp/lcd/brick_panel.c
--- a/drivers/video/fbdev/sunxi/disp2/disp/lcd/brick_panel.c
+++ b/drivers/video/fbdev/sunxi/disp2/disp/lcd/brick_panel.c
@@ -240,6 +240,19 @@
 	END
 };
 
+/*
+ * The nv3052's last two waits, after sleep-out and after display-on, are
+ * TrimUI's for each: the Brick's U-Boot waits 220 and 120 ms, the Smart
+ * Pro's 250 and 250, with the same commands
+ */
+#ifdef CONFIG_LCD_BRICK_PANEL_SMARTPRO
+#define NV3052_SLEEP_OUT_MS	250
+#define NV3052_ON_MS		250
+#else
+#define NV3052_SLEEP_OUT_MS	220
+#define NV3052_ON_MS		120
+#endif
+
 static const u8 nv3052_init[] = {
 	1, 0xff, 0x30,
 	1, 0xff, 0x52,
@@ -381,9 +394,9 @@
 	1, 0x36, 0x02,
 	1, 0x53, 0x2c,
 	0, 0x11,
-	DELAY, 220,
+	DELAY, NV3052_SLEEP_OUT_MS,
 	0, 0x29,
-	DELAY, 120,
+	DELAY, NV3052_ON_MS,
 	END
 };
 
@@ -518,7 +531,309 @@
 	END
 };
 
