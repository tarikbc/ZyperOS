#!/bin/sh
# The Brick's hardware, from inittab's sysinit after the splash and the mounts,
# before the card and ZyperOS (datapart, zyperos): what the Pixel 2's kernel and
# its daemons bring up on their own. The card's read-ahead, the RCU pace, the
# watchdog, the CPU governor for the boot, the GPU's modules, the pad's, and
# the mute switch's pin. The kernel modules and the system's own tools are in
# the root (/usr/lib/brick). Each step's time since the kernel started goes to
# /tmp/boot-times.

L=/usr/lib/brick
# The closed files' lists (package/pvr-ge8300, xr829-firmware: size and name
# a line) and their folder on the boot partition, or a check's own
# (ZyperOS's tools/closedcheck-check.sh, which sources this with
# BRICK_INIT_TEST)
CLOSED_LISTS=${CLOSED_LISTS:-/usr/share/zyperos/closed}
CLOSED_DIR=${CLOSED_DIR:-/boot/closed}

mark() { echo "$(cut -d' ' -f1 /proc/uptime) $1" >> /tmp/boot-times; }

# The Brick's closed files on the card, each the size its list says: the
# PowerVR driver and the XR829 firmware, the player's own copy, which the
# ZyperOS Installer puts in the boot partition's closed/ and the system links
# to. Says the first that isn't, and fails; quiet when all are there.
closed_check() {
	found=0
	for list in "$CLOSED_LISTS"/*.list; do
		[ -f "$list" ] || continue
		found=1
		while read -r size name; do
			[ -n "$name" ] || continue
			have=$(wc -c 2>/dev/null < "$CLOSED_DIR/$name" | tr -d ' ')
			[ "$have" = "$size" ] || { echo "$name"; return 1; }
		done < "$list"
	done
	[ "$found" = 1 ] || { echo "(no list of them)"; return 1; }
}

start() {
	# The card read ahead 2 MB at a time rather than 128 KB, first, before
	# anything below loads: the boot reads about 15 MB from the root before
	# ZyperOS's first frame, mostly libraries, and at 128 KB that was 533
	# small requests at about 24 MB/s on a card that does 65. At 2048 KB,
	# 310, and ZyperOS's start 40-90 ms quicker; 4096 was no better
	# (measured 2026-10-18, three cold boots each at 512, 1024, 2048, 4096).
	echo 2048 > /sys/block/mmcblk0/queue/read_ahead_kb
	# RCU grace periods expedited, as the kernel had them until now
	# (RCU_EXPEDITE_BOOT): closing an input device waits for one, about
	# 40 ms at the normal pace, and SDL's joystick setup closes each of the
	# four in turn, 186 ms of ZyperOS's start where it is 17 ms expedited
	# (measured 2026-10-12). Diatom does the same at every game.
	echo 1 > /sys/kernel/rcu_expedited
	watchdog -t 4 /dev/watchdog 2>/dev/null
	mark init

	# Which of its six panels the kernel found (kernel patch 0012 says it in
	# its log, the name after the id's bytes): said under the boot animation
	# (the splash's line, /tmp/splash-say), so a tester sees it with no
	# computer, and kept with the start's marks, which the log pack carries
	panel=$(dmesg | sed -n 's/.*brick panel: //p' | grep -v '^0x' | tail -1)
	if [ -n "$panel" ]; then
		echo "panel: $panel" > /tmp/splash-say
		mark "panel: $panel"
	fi

	# The boot partition, read-only at /boot, before anything loads from it:
	# the GPU's driver its firmware, ZyperOS's libraries the rest. System
	# Update remounts it to write a slot's files (ZyperOS's update/slots.c).
	# A card without the closed files can't start ZyperOS: the splash says so
	# instead, until POWER turns the Brick off, and nothing else starts
	mount -t vfat -o ro,noatime,nosuid,nodev /dev/mmcblk0p1 /boot
	if ! missing=$(closed_check); then
		echo "brick: the closed files are not all on the card ($missing missing): ZyperOS can't start" > /dev/kmsg
		echo "$missing" > /tmp/zyperos-no-start
		kill $(pidof splash) 2>/dev/null
		splash missing &
		return
	fi
	mark closed

	# The boot at full speed: the performance governor until ZyperOS has
	# drawn its first frame, then ondemand, which otherwise starts at 408 MHz
	# and is still ramping up while ZyperOS starts. The splash ends at that
	# first frame, so its going is the sign; it gives up by itself if ZyperOS
	# never draws, after 15 s, and 20 s here is the bound past that. The
	# splash is inittab's first line (/etc/init.d/splash), so it is running
	G=/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
	splash=$(pidof splash)
	(
		for i in $(seq 1 200); do [ -w $G ] && break; sleep 0.01; done
		echo performance > $G
		for i in $(seq 1 400); do [ -n "$splash" ] && [ -d /proc/$splash ] || break; sleep 0.05; done
		echo ondemand > $G
		# Rechecked every 50 ms rather than every 2 s, the kernel's own
		# setting, and raised at 80% busy rather than 95: a game started
		# from the shelf, or resumed from ZyperOS's menu, ran up to 2 s at
		# 408-600 MHz before the next check, its frames 20-60 ms late and its
		# sound running dry - heard as a sluggish start and a stutter after
		# the menu (measured 2026-10-21, a Diatom logging its first 3 s)
		O=/sys/devices/system/cpu/cpufreq/ondemand
		echo 50000 > $O/sampling_rate
		echo 80 > $O/up_threshold
		mark "governor: ondemand"
	) &

	# The GPU's own driver, then its display half (dc_sunxi), which waits
	# for the panel to finish powering up: from here, in the background,
	# beside the card's partition being found and mounted (datapart).
	# Nothing needs them until ZyperOS's video setup, which waits for them if
	# it has to (brick.c). Loaded beside launch.sh instead, they slowed whichever of its
	# card reads met them, 30-60 ms on some boots; from here, this script's
	# start to ZyperOS's main took 213-226 ms where it was 210-266 that way and
	# 240 loading them in turn (three cold boots each, 2026-10-18)
	(
		insmod $L/pvrsrvkm.ko
		mark gpu
		insmod $L/dc_sunxi.ko
		mark "gpu display"
	) &

	# The time before the kernel, from the timer that counts from reset
	[ -x $L/sincereset ] && $L/sincereset >> /tmp/boot-times

	# The pad, after the volume keys, power key and jack, which keep event0-2:
	# before ZyperOS, as Diatom opens it the moment it starts. On the TrimUI
	# Smart Pro, which runs this system with its own device (/etc/zyperos/
	# system), every button and both sticks are two small controllers on
	# serial ports, which ZyperOS's sppad turns into one gamepad: its 5 V
	# first (PD11, GPIO 107, as TrimUI's start script sets it), then sppad,
	# which powers both halves itself. brick-pad never loads there: it would
	# take PD15 and PD19, the halves' serial lines, as buttons
	if grep -q '^device smartpro$' /etc/zyperos/system 2> /dev/null; then
		[ -d /sys/class/gpio/gpio107 ] || echo 107 > /sys/class/gpio/export
		echo out > /sys/class/gpio/gpio107/direction
		echo 1 > /sys/class/gpio/gpio107/value
		/usr/lib/zyperos/sppad > /tmp/sppad.log 2>&1 &
	else
		insmod $L/brick-pad.ko
	fi
	mark pad

	# The mute switch (PH19), exported for ZyperOS, which reads
	# /sys/class/gpio/gpio243/value: 1 when down. The direction is what makes
	# the pin an input: exported alone it stays disabled and reads a stale 1
	[ -d /sys/class/gpio/gpio243 ] || echo 243 > /sys/class/gpio/export
	echo in > /sys/class/gpio/gpio243/direction
}

[ -n "$BRICK_INIT_TEST" ] || case "$1" in
start) start ;;
*) echo "usage: $0 start" >&2; exit 1 ;;
esac
