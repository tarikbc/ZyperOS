# ZyperOS on top of the base Pixel 2 system (configs/px2_defconfig).
# scripts/build.sh merges this into the base config for the ZyperOS image.

BR2_TARGET_GENERIC_ISSUE="ZyperOS"

# The base overlay first, then ZyperOS's, whose files win (its inittab starts
# the splash first)
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PX2_PATH)/board/px2/rootfs-overlay $(BR2_EXTERNAL_PX2_PATH)/board/zyperos/rootfs-overlay"

# ZyperOS's boot screen, the moment the panel lights
BR2_PACKAGE_SPLASH=y

# Libraries ZyperOS and Diatom load. SDL2_image with PNG and JPEG (box art and
# cards), SDL2_ttf for text, sqlite for settings and zlib for RetroAchievements
# hashing (both loaded at runtime), FFmpeg for MP4's music and audiobooks.
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_SDL2_TTF=y
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_SWSCALE=y
# Its libraries only: MP4 links them, and nothing runs the ffmpeg program
# BR2_PACKAGE_FFMPEG_FFMPEG is not set
# dav1d, the AV1 decoder FFmpeg then uses for MP4's videos (--enable-libdav1d,
# listed before FFmpeg's own): FFmpeg's own AV1 decoder only drives a hardware
# one, which this GPU does not have, so an AV1 video showed no picture.
# dav1d decodes on the CPU, with its aarch64 NEON code. BSD-2-Clause.
BR2_PACKAGE_DAV1D=y

# ZyperOS and Diatom themselves, built from their own repositories (mounted
# into the build container; see the Makefile)
BR2_PACKAGE_ZYPEROS=y
BR2_PACKAGE_DIATOM=y

# Ports: PortMaster's port scripts are bash ([[ ]], arrays, process
# substitution), and Stardew Valley's MonoGame loads libopenal.so.1 for its
# sound. Busybox's ash runs neither script. PortMaster's LOVE 11.5 runtime
# (Nova Pinball and the other LOVE ports) loads libvorbisfile.so.3 (libvorbis,
# with libogg), libtheoradec.so.1 (libtheora) and libmpg123.so.0 (mpg123):
# all it needs beyond its own libs.aarch64, as its loader lists them.
# Buildroot hides a package busybox also provides unless asked to show them
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_OPENAL=y
BR2_PACKAGE_LIBVORBIS=y
BR2_PACKAGE_LIBTHEORA=y
BR2_PACKAGE_MPG123=y
# PortMaster's Westonpack runtime (weston_pkg_0.2: Weston and Xwayland, for
# the ports that draw through X11 or Wayland, 88 of its 1,511 on 2026-11-20,
# Godot's and Java's among them) brings its own Wayland, X11, libinput and
# seatd, and takes the rest from the system. The system lacked two of
# those: libevdev.so.2, which its weston and libinput load, so every
# Westonpack port stopped at its start ("wp_weston: error while loading
# shared libraries: libevdev.so.2"), and libbz2.so.1.0, which
# its Xwayland loads through its own libXfont2, where an X11 port would
# stop next. Both small: libevdev (MIT) and bzip2's libbz2 (its own
# BSD-style license). With bzip2 here, Buildroot also builds FreeType and
# FFmpeg with it. ports-libs.txt lists every library the ports and their
# runtimes take from the system, and plastron's scripts/release.sh checks
# the image has each one.
BR2_PACKAGE_LIBEVDEV=y
BR2_PACKAGE_BZIP2=y
# And libudev.so.1, which its weston loads next (1.1.0: "wp_weston: error
# while loading shared libraries: libudev.so.1"). Crusty's stand-in libudev
# in the runtime is not in the folders its westonwrap.sh puts on the
# library path, so weston takes libudev from the system, which had none (no
# udev here). libudev-zero (package/libudev-zero, ISC) is libudev.so.1 alone,
# reading /sys and /dev itself: only the library goes in, nothing in
# staging, so SDL2 and the rest still build without udev, and it is no udev
# provider (BR2_PACKAGE_HAS_UDEV stays off).
BR2_PACKAGE_LIBUDEV_ZERO=y
# Info-ZIP's zip: PortMaster's GameMaker ports (gmloader: DEVOLVER Bootleg,
# Bot Vice and some 330 more) pack their game's assets at their first start
# with "zip -r -0 game.port ./assets/" and delete the assets after it,
# unchecked, or stop at "Missing zip!". Busybox has unzip, not zip.
# ports-cmds.txt lists the commands the ports' scripts need from the system.
BR2_PACKAGE_ZIP=y

# PortMaster itself (portmaster.games), which the Ports shelf installs when
# it is not on the card (ZyperOS's src/pminstall.c, res/portmaster/pm-install.py):
# its window and its port store (pugwash, harbourmaster) are Python 3 on SDL2
# through ctypes, with every Python library of its own in PortMaster/exlibs.
# What it takes from the system, and no more: Python 3, precompiled only, with
# ssl (HTTPS to GitHub and its port store), zlib (the ports' zips), xz (its
# Chinese, Japanese and Korean fonts come as a .tar.xz), the xml module (the
# ports' gameinfo.xml) and unicodedata (its text); libffi, for ctypes, comes
# with Python. SDL2_mixer for its sounds and music, which are Ogg, decoded by
# SDL2_mixer itself. No SDL2_gfx: only themes with rounded boxes use it, and
# it does without. And the root certificates (Debian's ca-certificates, as
# /etc/ssl/certs/ca-certificates.crt, which curl and OpenSSL read by default):
# the system had none, so its curl failed every HTTPS request it was not
# handed a bundle for, PortMaster's own check for the internet among them.
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PYC_ONLY=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON3_XZ=y
BR2_PACKAGE_PYTHON3_PYEXPAT=y
BR2_PACKAGE_PYTHON3_UNICODEDATA=y
BR2_PACKAGE_SDL2_MIXER=y
BR2_PACKAGE_CA_CERTIFICATES=y

# Wi-Fi File Transfer's hotspot: when the handheld is on no network, ZyperOS
# makes the Wi-Fi adapter an access point (src/hotspot.c), and a phone joins
# it by a QR code. hostapd runs the access point over nl80211; ZyperOS gives
# addresses with busybox's udhcpd and answers DNS itself. The kernel's
# rtl8xxxu has no access point for the RTL8188EU (the TL-WN725N v2/v3), so
# those adapters go to Realtek's own driver, rtl8188eu
# (rootfs-overlay/etc/modprobe.d/rtl8188eu.conf), which has one. It needs
# upstream's fix for kernel 7.1 (patches/rtl8188eu): Buildroot 2026.02.3 pins
# the commit before it.
BR2_PACKAGE_RTL8188EU=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
# Nothing hostapd has beyond WPA2-PSK on one fixed channel: no Prism2 host AP
# driver, no automatic channel choice, no VLANs
# BR2_PACKAGE_HOSTAPD_DRIVER_HOSTAP is not set
# BR2_PACKAGE_HOSTAPD_ACS is not set
# BR2_PACKAGE_HOSTAPD_VLAN is not set

# Patches to Buildroot's packages for ZyperOS: SDL2's evdev guess, so SDL
# programs (PortMaster's ports, gptokeyb) find the Pixel 2's buttons-only pad,
# and its scan for keyboards without udev, so a port sees the keys gptokeyb
# types for it; and rtl8188eu's build on kernel 7.1 (above)
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_PX2_PATH)/board/zyperos/patches"
