# ZyperOS on top of the base Pixel 2 system (configs/px2_defconfig).
# scripts/build.sh merges this into the base config for the ZyperOS image.

BR2_TARGET_GENERIC_ISSUE="ZyperOS"

# The base overlay first, then ZyperOS's, whose files win (its inittab starts
# the splash first)
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PX2_PATH)/board/px2/rootfs-overlay $(BR2_EXTERNAL_PX2_PATH)/board/zyperos/rootfs-overlay"

# ZyperOS's boot screen, the moment the panel lights
BR2_PACKAGE_SPLASH=y

# Libraries ZyperOS and Diatom load. SDL2_image with PNG and JPEG (box art and
# cards), SDL2_ttf for text, sqlite for settings and zlib for RetroAchievements
# hashing (both loaded at runtime), FFmpeg for Muse's music and audiobooks.
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_SDL2_TTF=y
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_SWSCALE=y
# Its libraries only: Muse links them, and nothing runs the ffmpeg program
# BR2_PACKAGE_FFMPEG_FFMPEG is not set

# ZyperOS and Diatom themselves, built from their own repositories (mounted
# into the build container; see the Makefile)
BR2_PACKAGE_ZYPEROS=y
BR2_PACKAGE_DIATOM=y

# Ports: PortMaster's port scripts are bash ([[ ]], arrays, process
# substitution), and Stardew Valley's MonoGame loads libopenal.so.1 for its
# sound. Busybox's ash runs neither script. PortMaster's LOVE 11.5 runtime
# (Nova Pinball and the other LOVE ports) loads libvorbisfile.so.3 (libvorbis,
# with libogg), libtheoradec.so.1 (libtheora) and libmpg123.so.0 (mpg123):
# all it needs beyond its own libs.aarch64, as its loader lists them.
# Buildroot hides a package busybox also provides unless asked to show them
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_OPENAL=y
BR2_PACKAGE_LIBVORBIS=y
BR2_PACKAGE_LIBTHEORA=y
BR2_PACKAGE_MPG123=y

# Wi-Fi File Transfer's hotspot: when the handheld is on no network, ZyperOS
# makes the Wi-Fi adapter an access point (src/hotspot.c), and a phone joins
# it by a QR code. hostapd runs the access point over nl80211; ZyperOS gives
# addresses with busybox's udhcpd and answers DNS itself. The kernel's
# rtl8xxxu has no access point for the RTL8188EU (the TL-WN725N v2/v3), so
# those adapters go to Realtek's own driver, rtl8188eu
# (rootfs-overlay/etc/modprobe.d/rtl8188eu.conf), which has one. It needs
# upstream's fix for kernel 7.1 (patches/rtl8188eu): Buildroot 2026.02.3 pins
# the commit before it.
BR2_PACKAGE_RTL8188EU=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
# Nothing hostapd has beyond WPA2-PSK on one fixed channel: no Prism2 host AP
# driver, no automatic channel choice, no VLANs
# BR2_PACKAGE_HOSTAPD_DRIVER_HOSTAP is not set
# BR2_PACKAGE_HOSTAPD_ACS is not set
# BR2_PACKAGE_HOSTAPD_VLAN is not set

# Patches to Buildroot's packages for ZyperOS: SDL2's evdev guess, so SDL
# programs (PortMaster's ports, gptokeyb) find the Pixel 2's buttons-only pad,
# and its scan for keyboards without udev, so a port sees the keys gptokeyb
# types for it; and rtl8188eu's build on kernel 7.1 (above)
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_PX2_PATH)/board/zyperos/patches"
