From: ZyperOS
Subject: [PATCH] kmsdrm: turn the output for a panel mounted turned

With SDL_KMSDRM_ROTATION=90 or 270, programs get a landscape window on the
GKD Pixel 2's 480x640 portrait panel, and each frame is turned onto the
panel by a GLES blit at swap (SDL_kmsdrmrotate.c), into XRGB buffers so a
game that leaves alpha at 0 is not shown black, flushed rather than waited
for, and flipped mailbox-style: the swap never waits for the display, the
newest frame goes up at the next refresh (SDL_KMSDRM_VSYNC=1 for SDL's
blocking swap). The cursor stays hidden. SDL_KMSDRM_DUMP=N saves the Nth
turned frame to /tmp/kmsdrm-frame.rgba, and SDL_KMSDRM_FPS=1 prints frames
a second and the turn's cost to stderr. The VOP cannot turn a plane, and
RGA needs the vendor kernel.
---
diff --color -ruN a/src/video/kmsdrm/SDL_kmsdrmmouse.c b/src/video/kmsdrm/SDL_kmsdrmmouse.c
--- a/src/video/kmsdrm/SDL_kmsdrmmouse.c	2026-11-03 21:02:49
+++ b/src/video/kmsdrm/SDL_kmsdrmmouse.c	2026-11-03 21:03:05
@@ -307,6 +307,13 @@
     int num_displays, i;
     int ret = 0;
 
+    /* No pointer on a handheld whose picture is turned (SDL_KMSDRM_ROTATION):
+       the cursor plane is not turned with it, and it only ever showed as an
+       arrow in a corner over the game */
+    if (((SDL_VideoData *)SDL_GetVideoDevice()->driverdata)->rotation) {
+        cursor = NULL;
+    }
+
     /* Get the mouse focused window, if any. */
 
     mouse = SDL_GetMouse();
diff --color -ruN a/src/video/kmsdrm/SDL_kmsdrmopengles.c b/src/video/kmsdrm/SDL_kmsdrmopengles.c
--- a/src/video/kmsdrm/SDL_kmsdrmopengles.c	2026-11-03 21:02:49
+++ b/src/video/kmsdrm/SDL_kmsdrmopengles.c	2026-11-03 22:58:35
@@ -110,6 +110,11 @@
         KMSDRM_CreateSurfaces(_this, window);
     }
 
+    /* A turned panel swaps without waiting for the display (SDL_kmsdrmrotate.c) */
+    if (windata->rotator && !SDL_getenv("SDL_KMSDRM_VSYNC")) {
+        return KMSDRM_RotatorSwap(_this, window);
+    }
+
     /* Wait for confirmation that the next front buffer has been flipped, at which
        point the previous front buffer can be released */
     if (!KMSDRM_WaitPageflip(_this, windata)) {
@@ -143,7 +148,14 @@
     }
 
     /* Get an actual usable fb for the next front buffer. */
-    fb_info = KMSDRM_FBFromBO(_this, windata->next_bo);
+    if (windata->rotator) {
+        /* A turned panel: the landscape frame goes on screen a quarter turn
+           round, through a buffer of the panel's own shape */
+        struct gbm_bo *turned = KMSDRM_RotatorDraw(windata->rotator, windata->next_bo);
+        fb_info = KMSDRM_FBFromBO(_this, turned ? turned : windata->next_bo);
+    } else {
+        fb_info = KMSDRM_FBFromBO(_this, windata->next_bo);
+    }
     if (!fb_info) {
         SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "Could not get a framebuffer");
         return 0;
diff --color -ruN a/src/video/kmsdrm/SDL_kmsdrmrotate.c b/src/video/kmsdrm/SDL_kmsdrmrotate.c
--- a/src/video/kmsdrm/SDL_kmsdrmrotate.c	1969-12-31 21:00:00
+++ b/src/video/kmsdrm/SDL_kmsdrmrotate.c	2026-11-03 22:59:10
@@ -0,0 +1,638 @@
