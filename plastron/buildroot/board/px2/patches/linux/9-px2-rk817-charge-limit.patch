From: plastron
Subject: [PATCH] power: supply: rk817: a charge limit

charge_control_end_threshold and charge_control_start_threshold on the
battery, the kernel's standard pair, so that ZyperOS can stop charging at
80, 85 or 90% to keep the GKD Pixel 2's battery healthy for longer.

At the end threshold the USB input current limit is held to its least,
80 mA, under what the system draws: the battery takes no charge and gives
the rest, falling slowly to the start threshold, where the input limit the
cable came with is put back and it charges again. The start follows the
end 5 points under it unless it is written after. An end of 100, the
default, is no limit. While held with the cable in, the battery's status
is "Not charging".

Not the charger's enable (PMIC_CHRG_OUT bit 7), nor its voltage lowered
under the battery's: either puts the charger off (CHRG_STS CHRG_OFF), and
on a GKD Pixel 2 the battery is then off the system as well - its current
fell to nothing - so the handheld lost its power the moment the cable came
out (OFF_SOURCE 0x10 at the next start), both ways (2026-11-06). Held to
80 mA, the battery gave 110 to 140 mA to the system, and a cable pulled
kept it running.

The limit is let go when the cable comes out and at shutdown, so a charger
plugged into a Pixel 2 that is off charges it at the cable's own limit. The
charger's enable is set at probe, as Rockchip's own driver does at its
start. The gauge's full-charge calibration runs on CHARGE_FINISH, and not
while the limit holds the battery; a full charge now and then (ZyperOS's
"Hold A for a full charge") gives it one.
---
 drivers/power/supply/rk817_charger.c | 128 ++++++++++++++++++++++++++++++++++-
 1 file changed, 125 insertions(+), 3 deletions(-)

diff --git a/drivers/power/supply/rk817_charger.c b/drivers/power/supply/rk817_charger.c
index 81c50f8..822bb97 100644
--- a/drivers/power/supply/rk817_charger.c
+++ b/drivers/power/supply/rk817_charger.c
@@ -18,6 +18,16 @@
 #include <linux/power_supply.h>
 #include <linux/regmap.h>
 
+/*
+ * The charger's enable, bit 7 of PMIC_CHRG_OUT, as Rockchip's own driver
+ * has it (REG_FIELD(0xE4, 7, 7)); rk808.h's RK817_CHRG_EN is bit 6 of
+ * PMIC_CHRG_TERM, which lets USB power the system. Only ever set here.
+ */
+#define RK817_CHRG_OUT_EN	BIT(7)
+
+/* How far under the end threshold charging starts again, by default */
+#define RK817_CHARGE_LIMIT_GAP	5
+
 /* Charging statuses reported by hardware register */
 enum rk817_charge_status {
 	CHRG_OFF,
@@ -108,6 +118,24 @@ struct rk817_charger {
 	/* Work queue to periodically update values. */
 	struct delayed_work work;
 
+	/*
+	 * The charge limit (charge_control_end_threshold and _start_threshold,
+	 * in percent). At the end threshold the USB input is held to 80 mA,
+	 * under what the system draws, so the battery takes no charge and gives
+	 * the rest; at the start threshold the input limit is put back. An end
+	 * of 100 is no limit. held: held so now, the cable in.
+	 *
+	 * Not the charger's enable, nor its voltage lowered under the battery's:
+	 * either puts the charger off (CHRG_STS CHRG_OFF), and on a GKD Pixel 2
+	 * the battery is then off the system too (its current fell to nothing),
+	 * which lost its power the moment the cable came out, OFF_SOURCE 0x10.
+	 * Held to 80 mA, the battery gave 110 to 140 mA and a cable pulled kept
+	 * it running (2026-11-06).
+	 */
+	int end_threshold;
+	int start_threshold;
+	bool held;
+
 	/*
 	 * The USB PHY's charger detection (BC1.2), when the device tree points
 	 * the charger node at it with an extcon phandle: the input current
@@ -276,9 +304,13 @@ static int rk817_bat_calib_cap(struct rk817_charger *charger)
 		return -EINVAL;
 	}
 
-	/* Calibrate the soc and fcc on a fully charged battery */
+	/*
+	 * Calibrate the soc and fcc on a fully charged battery. Not while the
+	 * charge limit holds it: a battery held there is not charging to full.
+	 */
 
-	if (charger->charge_status == CHARGE_FINISH && (!charger->soc_cal)) {
+	if (charger->charge_status == CHARGE_FINISH && !charger->held &&
+	    (!charger->soc_cal)) {
 		/*
 		 * soc should be 100000 and columb counter should show the full
 		 * charge capacity. Note that if the device is unplugged for a
@@ -307,7 +339,8 @@ static int rk817_bat_calib_cap(struct rk817_charger *charger)
 	 * The columb counter can drift up slightly, so we should correct for
 	 * it. But don't correct it until we're at 100% soc.
 	 */
-	if (charger->charge_status == CHARGE_FINISH && charger->soc_cal) {
+	if (charger->charge_status == CHARGE_FINISH && !charger->held &&
+	    charger->soc_cal) {
 		regmap_bulk_read(rk808->regmap, RK817_GAS_GAUGE_Q_PRES_H3,
 				 bulk_reg, 4);
 		charge_now_adc = get_unaligned_be32(bulk_reg);
@@ -455,6 +488,11 @@ static int rk817_bat_get_prop(struct power_supply *ps,
 		val->intval = charger->battery_present;
 		break;
 	case POWER_SUPPLY_PROP_STATUS:
+		/* Held at the charge limit: on the cable, and not charging */
+		if (charger->held && charger->plugged_in) {
+			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+			break;
+		}
 		if (charger->cur_avg_ua < 0) {
 			val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
 			break;
@@ -535,6 +573,12 @@ static int rk817_bat_get_prop(struct power_supply *ps,
 	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE_MAX:
 		val->intval = charger->max_chg_volt_uv;
 		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
+		val->intval = charger->end_threshold;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
+		val->intval = charger->start_threshold;
+		break;
 	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
 		val->intval = charger->bat_voltage_max_design_uv;
 		break;
@@ -551,6 +595,7 @@ static int rk817_bat_get_prop(struct power_supply *ps,
  */
 static const int rk817_ilim_ma[] = { 450, 80, 850, 1500, 1750, 2000, 2500, 3000 };
 
+#define RK817_ILIM_80MA		0x01
 #define RK817_ILIM_1500MA	0x03
 #define RK817_ILIM_2000MA	0x05
 
@@ -569,6 +614,9 @@ static void rk817_set_input_limit(struct rk817_charger *charger)
 	if (charger->edev &&
 	    extcon_get_state(charger->edev, EXTCON_CHG_USB_DCP) > 0)
 		sel = RK817_ILIM_2000MA;
+	/* Held at the charge limit: the battery gives what 80 mA does not */
+	if (charger->held && charger->plugged_in)
+		sel = RK817_ILIM_80MA;
 
 	regmap_write_bits(rk808->regmap, RK817_PMIC_CHRG_IN,
 			  RK817_USB_ILIM_SEL, sel);
@@ -598,6 +646,32 @@ static int rk817_dcp_notifier(struct notifier_block *nb, unsigned long event,
 	return NOTIFY_OK;
 }
 
+/*
+ * The charge limit kept: held at the end threshold, let go at the start.
+ * Only with the cable in: out, nothing is held, and the input limit the
+ * cable came with is back for the next one.
+ */
+static void rk817_charge_limit(struct rk817_charger *charger)
+{
+	int cap = (charger->soc + 500) / 1000;
+	bool hold = charger->held;
+
+	if (charger->end_threshold >= 100 || !charger->plugged_in)
+		hold = false;
+	else if (cap >= charger->end_threshold)
+		hold = true;
+	else if (cap <= charger->start_threshold)
+		hold = false;
+
+	if (hold == charger->held)
+		return;
+	charger->held = hold;
+	rk817_set_input_limit(charger);
+	dev_dbg(charger->dev, "charge limit: %s at %d%%\n",
+		hold ? "held" : "charging", cap);
+	power_supply_changed(charger->bat_ps);
+}
+
 static int rk817_chg_get_prop(struct power_supply *ps,
 			      enum power_supply_property prop,
 			      union power_supply_propval *val)
@@ -657,6 +731,7 @@ static irqreturn_t rk817_plug_in_isr(int irq, void *cg)
 	charger->soc_cal = 0;
 
 	rk817_read_props(charger);
+	rk817_charge_limit(charger);
 
 	dev_dbg(charger->dev, "Power Cord Inserted\n");
 
@@ -689,6 +764,7 @@ static irqreturn_t rk817_plug_out_isr(int irq, void *cg)
 	rk817_set_input_limit(charger);
 
 	rk817_read_props(charger);
+	rk817_charge_limit(charger);
 
 	dev_dbg(charger->dev, "Power Cord Removed\n");
 
@@ -708,9 +784,23 @@ static int rk817_bat_set_prop(struct power_supply *ps,
 			return -EINVAL;
 		charger->fcc_mah = val->intval / 1000;
 		return rk817_bat_calib_cap(charger);
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
+		/* The start follows the end, RK817_CHARGE_LIMIT_GAP under it */
+		if (val->intval < 50 || val->intval > 100)
+			return -EINVAL;
+		charger->end_threshold = val->intval;
+		charger->start_threshold = max(0, val->intval - RK817_CHARGE_LIMIT_GAP);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
+		if (val->intval < 0 || val->intval >= charger->end_threshold)
+			return -EINVAL;
+		charger->start_threshold = val->intval;
+		break;
 	default:
 		return -EINVAL;
 	}
+	rk817_charge_limit(charger);
+	return 0;
 }
 
 static enum power_supply_property rk817_bat_props[] = {
@@ -728,6 +818,8 @@ static enum power_supply_property rk817_bat_props[] = {
 	POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
 	POWER_SUPPLY_PROP_CAPACITY,
 	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD,
+	POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD,
 };
 
 static enum power_supply_property rk817_chg_props[] = {
@@ -744,6 +836,8 @@ static int rk817_bat_prop_writeable(struct power_supply *psy,
 {
 	switch (psp) {
 	case POWER_SUPPLY_PROP_CHARGE_FULL:
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
 		return 1;
 	default:
 		return 0;
@@ -1108,6 +1202,7 @@ static void rk817_charging_monitor(struct work_struct *work)
 	charger = container_of(work, struct rk817_charger, work.work);
 
 	rk817_read_props(charger);
+	rk817_charge_limit(charger);
 
 	/* Run every 8 seconds like the BSP driver did. */
 	queue_delayed_work(system_percpu_wq, &charger->work, msecs_to_jiffies(8000));
@@ -1149,6 +1244,16 @@ static int rk817_charger_probe(struct platform_device *pdev)
 	charger->dev = &pdev->dev;
 	platform_set_drvdata(pdev, charger);
 
+	/*
+	 * No charge limit until one is asked for, and the charger enabled, as
+	 * Rockchip's own driver has it at its start (a kernel may have left it
+	 * off: an earlier take on the charge limit cleared it)
+	 */
+	charger->end_threshold = 100;
+	charger->start_threshold = 100 - RK817_CHARGE_LIMIT_GAP;
+	regmap_write_bits(rk808->regmap, RK817_PMIC_CHRG_OUT, RK817_CHRG_OUT_EN,
+			  RK817_CHRG_OUT_EN);
+
 	/* The USB PHY's charger detection, if the device tree names it */
 	if (of_property_present(node, "extcon")) {
 		struct device_node *phy = of_parse_phandle(node, "extcon", 0);
@@ -1321,8 +1426,25 @@ static int __maybe_unused rk817_resume(struct device *dev)
 
 static SIMPLE_DEV_PM_OPS(rk817_charger_pm, rk817_suspend, rk817_resume);
 
+/*
+ * Off or restarting: the input limit the cable came with put back, as a
+ * charger plugged into a handheld that is off charges it with no kernel to
+ * keep a limit
+ */
+static void rk817_charger_shutdown(struct platform_device *pdev)
+{
+	struct rk817_charger *charger = platform_get_drvdata(pdev);
+
+	cancel_delayed_work_sync(&charger->work);
+	if (charger->held) {
+		charger->held = false;
+		rk817_set_input_limit(charger);
+	}
+}
+
 static struct platform_driver rk817_charger_driver = {
 	.probe    = rk817_charger_probe,
+	.shutdown = rk817_charger_shutdown,
 	.driver   = {
 		.name  = "rk817-charger",
 		.pm		= &rk817_charger_pm,
