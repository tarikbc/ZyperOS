# Our changes to ROCKNIX's RK3326 kernel config (linux.config.rocknix).
# scripts/kernel-config.sh applies them to make linux.config. Before these,
# it turns every one of ROCKNIX's modules off, so what ROCKNIX builds as one
# either moves into the kernel below or goes.

# Modules only for what isn't always there: a USB Wi-Fi adapter's driver and
# the wireless stack under it (below), loaded when one is plugged in, so a
# boot without one reads and starts none of it. Everything else is built in.
CONFIG_MODULES=y
# And as little of module support built in as will do: only the exported
# symbols those modules use (every other export's table entry and name is
# left out, most of the 460 KB modules otherwise add), no unloading (the
# adapter is unplugged, its driver stays) and no symbol versions
CONFIG_TRIM_UNUSED_KSYMS=y
# CONFIG_MODULE_UNLOAD is not set
# CONFIG_MODVERSIONS is not set
# But the exports Realtek's rtl8188eu (the ZyperOS image's driver for the
# RTL8188EU adapters) uses are kept, though nothing in the tree uses them:
# without them it loads with "Unknown symbol" and there is no wlan0. The path
# is the build container's (/src is this repository, scripts/build.sh).
CONFIG_UNUSED_KSYMS_WHITELIST="/src/buildroot/board/px2/linux-ksyms.txt"

# Built in rather than modules: what this device needs from ROCKNIX's list
CONFIG_JOYSTICK_ROCKNIX_SINGLEADC=y
CONFIG_EXFAT_FS=y
CONFIG_DRM_PANFROST=y

# Only the PX30's clock driver: ROCKNIX's config builds every Rockchip SoC's
# CONFIG_CLK_RV1126B is not set
# CONFIG_CLK_RK3308 is not set
# CONFIG_CLK_RK3328 is not set
# CONFIG_CLK_RK3368 is not set
# CONFIG_CLK_RK3399 is not set
# CONFIG_CLK_RK3528 is not set
# CONFIG_CLK_RK3562 is not set
# CONFIG_CLK_RK3568 is not set
# CONFIG_CLK_RK3576 is not set
# CONFIG_CLK_RK3588 is not set

# Display: the VOP and MIPI DSI, nothing else. The panel driver is ROCKNIX's
# generic-dsi (patch 4), always built in.
# CONFIG_ROCKCHIP_ANALOGIX_DP is not set
# CONFIG_ROCKCHIP_CDN_DP is not set
# CONFIG_ROCKCHIP_DW_HDMI is not set
# CONFIG_ROCKCHIP_INNO_HDMI is not set
# CONFIG_ROCKCHIP_LVDS is not set
# CONFIG_ROCKCHIP_RGB is not set
# CONFIG_ROCKCHIP_RK3066_HDMI is not set
# CONFIG_DRM_PANEL_ELIDA_KD35T133 is not set
# CONFIG_DRM_PANEL_NEWVISION_NV3051D is not set
# CONFIG_DRM_PANEL_SITRONIX_ST7701 is not set
# CONFIG_DRM_PANEL_SITRONIX_ST7703 is not set
# CONFIG_DRM_PANEL_SIMPLE is not set
# CONFIG_LOGO is not set

# PHYs: USB and the DSI D-PHY only
# CONFIG_PHY_ROCKCHIP_DP is not set
# CONFIG_PHY_ROCKCHIP_DPHY_RX0 is not set
# CONFIG_PHY_ROCKCHIP_EMMC is not set
# CONFIG_PHY_ROCKCHIP_INNO_HDMI is not set
# CONFIG_PHY_ROCKCHIP_PCIE is not set
# CONFIG_PHY_ROCKCHIP_TYPEC is not set
# CONFIG_PHY_ROCKCHIP_USB is not set

# Sound: the RK817 codec through the I2S controller and simple-card
# CONFIG_SND_SOC_ES8316 is not set
# CONFIG_SND_SOC_ES8328 is not set
# CONFIG_SND_SOC_ES8328_I2C is not set
# CONFIG_SND_SOC_ES8328_SPI is not set
# CONFIG_SND_SOC_MAX98357A is not set
# CONFIG_SND_SOC_SPDIF is not set
# CONFIG_SND_SOC_DMIC is not set

# Input: no pwm-vibrator (the rumble motor is the joypad driver's force
# feedback, on the joypad's own input device; see the device tree),
# touchscreens, mice or other boards' joypads
# CONFIG_INPUT_PWM_VIBRA is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_JOYSTICK_ODROIDGO2 is not set
# CONFIG_JOYSTICK_ODROIDGO2_V11 is not set
# CONFIG_JOYSTICK_ODROIDGO3 is not set
# CONFIG_JOYSTICK_RGB20S is not set
# CONFIG_JOYSTICK_XU10 is not set
# CONFIG_JOYSTICK_GAMEFORCE_CHI is not set

# USB: device mode for development (the gadget), no host side. Nothing is
# plugged into the port in use, and USB gamepads and storage aren't wanted.
# CONFIG_HID_SUPPORT is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_SERIAL is not set

# A phone's USB tethering, as modules: a phone on the port takes the side
# that waits for power, so the Pixel is the host and powers it, and the
# phone shares its network over the cable (2026-11-13). Android's RNDIS
# (rndis_host, over cdc_ether), the CDC ECM and NCM some phones use
# (cdc_ether, cdc_ncm), and an iPhone's (ipheth, which needs the iPhone
# paired first). usbrole loads them by the phone's alias when tethering
# starts, so a boot without a phone reads none of it. Only these: no USB
# Ethernet adapters (AX88xxx and the rest that default on; RTL8153's ECM shim
# comes with cdc_ether and has no prompt to turn off).
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_IPHETH=m
# CONFIG_USB_NET_AX8817X is not set
# CONFIG_USB_NET_AX88179_178A is not set
# CONFIG_USB_NET_CDC_SUBSET is not set
# CONFIG_USB_NET_NET1080 is not set
# CONFIG_USB_NET_ZAURUS is not set
# CONFIG_USB_NET_CDC_EEM is not set
# CONFIG_AX88796B_PHY is not set

# Filesystems: squashfs for root (below; ext4 too, for a root written by hand
# while developing), FAT for boot, exFAT for games
# CONFIG_BTRFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_SMB_SERVER is not set
# CONFIG_FUSE_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_AUTOFS_FS is not set
# CONFIG_HUGETLBFS is not set
# CONFIG_NETWORK_FILESYSTEMS is not set

# Storage the device doesn't have
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MTD is not set
# CONFIG_MD is not set
# CONFIG_NVME_CORE is not set
# CONFIG_BLK_DEV_NBD is not set

# Networking: USB networking and SSH over it, and Wi-Fi from a USB adapter:
# Realtek's rtl8xxxu (the TL-WN725N v2/v3's RTL8188EUS, and the other chips
# it drives), rtw88's 8822BU (Edimax EW-7822ULC and other AC1200 USB
# adapters), and the wireless stack, as modules
# CONFIG_NETFILTER is not set
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
# Nothing more built in for it: no signed regulatory database (it builds in
# X.509 and PKCS#7 checking; only offered with CERTIFICATION_ONUS, which
# changes nothing else) and no wireless extensions (wpa_supplicant speaks
# nl80211)
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
# CONFIG_CFG80211_WEXT is not set
CONFIG_MAC80211=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=m
# rtw88 USB 8822BU only.
# Firmware is BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88 (rtw8822b_fw.bin).
CONFIG_RTW88=m
CONFIG_RTW88_8822BU=m
# CONFIG_RFKILL is not set
# CONFIG_BT is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_NET_SCHED is not set
# CONFIG_WIREGUARD is not set
# CONFIG_TUN is not set
# CONFIG_ETHERNET is not set
# CONFIG_PPP is not set
# CONFIG_CAN is not set
# CONFIG_NFC is not set
# CONFIG_IP_PNP is not set
# CONFIG_INET_ESP is not set
# CONFIG_XFRM_USER is not set
# CONFIG_NET_KEY is not set

# Hardware video codecs
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_STAGING is not set

# What systemd and general-purpose distributions need, and busybox doesn't
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BPF_JIT is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_AUDIT is not set
# CONFIG_SECURITY is not set
# CONFIG_IKCONFIG is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_PROFILING is not set
# CONFIG_VIRTUALIZATION is not set

# The kernel's deterministic random generator, which nothing here uses (it's
# for the likes of Bluetooth pairing), and the jitter-entropy source it pulls
# in, whose self-test took 145 ms of boot
# CONFIG_CRYPTO_DRBG_MENU is not set
# CONFIG_CRYPTO_JITTERENTROPY is not set

# No framebuffer console. It did the first mode-set (the panel's 0.7 s
# power-up) under the console lock, which held up init; patch 6 has the
# DRM driver set fbdev's mode from a work item instead. For kernel messages
# on screen while debugging, turn this back on (and see boot.cmd).
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# Second pass, from measuring what's still big in the built kernel.

# cgroups and what drags them in: SCHED_AUTOGROUP (a desktop scheduling
# tweak) selects them, and PSI and the memory, block and CPU controllers
# are only for service managers
# CONFIG_SCHED_AUTOGROUP is not set
# CONFIG_PSI is not set
# CONFIG_MEMCG is not set
# CONFIG_BLK_CGROUP is not set
# CONFIG_CGROUP_SCHED is not set
# CONFIG_CPUSETS is not set

# Kernel log: 16 KiB, not 128. The ring buffer's index alone was 352 KiB.
CONFIG_LOG_BUF_SHIFT=14
CONFIG_LOG_CPU_MAX_BUF_SHIFT=12

# No initramfs, so no decompressors for one; zstd and LZO came in through
# the crypto API for features (zram, zswap) not used here
# CONFIG_BLK_DEV_INITRD is not set
# CONFIG_CRYPTO_ZSTD is not set
# CONFIG_CRYPTO_LZO is not set

# USB: dual role. A device for a computer (Down To The Wire's USB networking:
# NCM, which macOS, Linux and Windows all have a driver for, where ECM had none
# on Windows; 2026-10-06)
# and a host for a USB-C DAC, with USB audio; usbrole picks by the ID pin.
# Measured 2026-10-05: 0.62 MB of kernel, about 22 ms from reset to shelf.
# Nothing else on the host side but a phone's tethering (above, modules): no
# storage, no gamepads, no modems.
CONFIG_USB_DWC2_DUAL_ROLE=y
# CONFIG_USB_DWC2_PERIPHERAL is not set
CONFIG_USB=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y
# CONFIG_USB_ACM is not set
CONFIG_USB_CONFIGFS_NCM=y
# CONFIG_USB_CONFIGFS_RNDIS is not set
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
# CONFIG_USB_CONFIGFS_F_FS is not set
# CONFIG_USB_CONFIGFS_ACM is not set
# CONFIG_USB_CONFIGFS_SERIAL is not set

# Nothing uses a console now: no virtual terminals, no serial port driver
# (the UART has no one on the other end without soldering)
# CONFIG_VT is not set
# CONFIG_SERIAL_8250 is not set

# Unused here: io_uring, SPI (no SPI devices), Unicode case-folding
# tables, suspend and hibernate (the device is powered off, never
# suspended), and perf events
# CONFIG_IO_URING is not set
# CONFIG_SPI is not set
# CONFIG_UNICODE is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# ROCKNIX's driver for the chip's suspend sleep modes, useless without suspend
# (and it won't build without it)
# CONFIG_ROCKCHIP_PM_CONFIG is not set
# ARM's hardware tracing, which also selects perf events
# CONFIG_CORESIGHT is not set
# CONFIG_PERF_EVENTS is not set

# No energy model: it is for scheduling across big and little cores, and the
# RK3326's four are all alike. What it did here was mark the two top clocks
# inefficient, and ondemand and schedutil skip inefficient clocks, so asked
# for the top speed they got 1200 MHz: Yoshi's Island (Super FX) ran short
# of frames there. step_wise, the thermal governor in use, doesn't need it
# (power_allocator, which does, goes with it).
# CONFIG_ENERGY_MODEL is not set

# The root is squashfs, read-only, LZ4: about half the bytes to read, and
# (with the sort list) the boot's files together at its front. Only LZ4 and
# no extended attributes: nothing else here makes or reads them
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZ4=y
# CONFIG_SQUASHFS_ZLIB is not set
# CONFIG_SQUASHFS_LZO is not set
# CONFIG_SQUASHFS_XZ is not set
# CONFIG_SQUASHFS_ZSTD is not set
# CONFIG_SQUASHFS_XATTR is not set

# squashfs in every compression PortMaster uses: its runtimes (Mono for
# Stardew Valley and Celeste, Godot, the JDKs) are squashfs images a port
# mounts, the Mono one gzip, others xz or zstd. Only LZ4 was built, for
# plastron's own root, and mounting Mono failed with "Invalid argument"
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

# DDR frequency scaling (ROCKNIX's 036-px30-dmc-devfreq, with Rockchip's
# BL31 and U-Boot's FSP_INIT): the DDR init blob leaves the memory at
# 333 MHz, and nothing in mainline raises it. Stardew Valley's farm ran at
# 3 fps there; the device's own firmware runs its LPDDR4 at up to 1056 MHz
CONFIG_ARM_PX30_DMC_DEVFREQ=y
CONFIG_DEVFREQ_EVENT_ROCKCHIP_DFI=y

# vdd_logic at 1.0 V or more while the CPU runs above 1008 MHz, as the
# device's own firmware has it (9-px2-px30-logic-floor.patch, the device
# tree's logic-floor)
CONFIG_ROCKCHIP_PX30_LOGIC_FLOOR=y

# The kernel's log kept across a reset (pstore's ramoops, in the RAM the
# device tree's ramoops@110000 sets aside, as the device's own firmware
# does): every kernel line as it is printed (the console, 512 KB), and the
# log's last 10 KB at a panic or an oops (dumps, pstore's default size). A
# panic reboots 10 s later (panic=10, through the RK817's restart) with
# the RAM's contents kept, so the next start reads them from /sys/fs/pstore:
# plastron's crashlog copies them to the card and PX2BOOT at every start.
# Plain text, not compressed: a panic writes it as fast as it can, and it is
# read as it is. No userspace messages (pmsg) and no ftrace.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# CONFIG_PSTORE_COMPRESS is not set
# CONFIG_PSTORE_PMSG is not set
# CONFIG_PSTORE_FTRACE is not set

# A freeze that leaves a report: a CPU stuck in the kernel panics, so pstore
# keeps its last lines and panic=10 reboots it (plastron's crashlog puts the
# report on the card at the start after). A soft lockup, 20 s in the kernel
# without a switch; a hard one, 10 s with its interrupts off, which the
# next CPU's timer sees (the buddy detector: no perf NMI on this chip); and
# an RCU stall (21 s), which crashlog sets to panic at every start. A task
# stuck on the card or a driver for 120 s is only said, in the log and in
# pstore's console, never a panic: a slow card's long write is no freeze.
# Only during the start, before the launcher and away from the card's long
# writes, does a task stuck 60 s panic (boot-prelude.cmd's sysctls, set back
# by datapart and zyperos.init).
# One GKD Pixel 2 froze in its menus and stayed frozen, with nothing in its
# logs (2026-11-15).
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=0

# The PX30's own watchdog (the device tree's &wdt, DesignWare's), for a
# freeze that nothing above catches: a boot that stops in the kernel before
# init (a Pixel 2 whose cold starts stopped under a second in, with the
# backlight on and no splash, for good: 2026-11-23), and a system that stops
# answering later. U-Boot starts it (board/px2/u-boot/px2.config), the kernel
# pets it from its probe on until something opens /dev/watchdog, for at most
# watchdog.open_timeout=60 s (boot-prelude.cmd), and plastron's hwdog opens
# it at init's first step and pets it from then on (package/hwdog): never the
# launcher, and nothing that touches the card, so a long copy to a slow card
# never stops it (the false reset PR #115 feared was a petter sharing the
# card). Its reset goes through the RK817 (below): pstore keeps the console,
# and crashlog reports it at the next start. HANDLE_BOOT_ENABLED is the kernel's petting
# of the one U-Boot started; no NOWAYOUT, so hwdog's magic close at a
# shutdown stops it (a shutdown waits on the card).
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
# CONFIG_WATCHDOG_NOWAYOUT is not set
CONFIG_DW_WATCHDOG=y
# Its first stage an interrupt, from the probe on (patches/linux
# 9-px2-dw-wdt-pretimeout): the panic governor panics, and the panic restarts
# through the RK817 (DEV_RST), a power cycle the card comes back from. The
# watchdog's own reset is the PX30's alone, which left the card in its 1.8 V
# signalling: the boot ROM could not read it and started the handheld's own
# loader (2026-11-26). The chip's reset stays, one TOP later.
CONFIG_WATCHDOG_PRETIMEOUT_GOV=y
# CONFIG_WATCHDOG_PRETIMEOUT_GOV_NOOP is not set
CONFIG_WATCHDOG_PRETIMEOUT_GOV_PANIC=y
CONFIG_WATCHDOG_PRETIMEOUT_DEFAULT_GOV_PANIC=y
