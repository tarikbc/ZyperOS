#include "px30.dtsi"

/ {
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * The kernel's log kept across a reset (pstore's ramoops,
		 * linux-px2.config): its console, a panic's or oops's dump,
		 * read back from /sys/fs/pstore on the next start. A reboot
		 * after a panic leaves the DDR powered, so they survive it; a
		 * power-off does not. Where the GKD Pixel 2's own firmware
		 * and twigUI keep theirs, 0x110000 for 960 KB: after BL31's
		 * share memory, below U-Boot's text at 2 MiB, in the 2 MiB
		 * U-Boot keeps from Linux for BL31 (here loaded at
		 * 0x40000-0x77000), so nothing else in the boot touches it.
		 * Their 512 KB console and 128 KB records; their 320 KB for
		 * userspace's messages (pmsg) goes to records instead, three
		 * of them, so three panics in a row are all kept.
		 */
		ramoops: ramoops@110000 {
			compatible = "ramoops";
			reg = <0x0 0x110000 0x0 0xf0000>;
			record-size = <0x20000>;
			console-size = <0x80000>;
			ftrace-size = <0x0>;
			pmsg-size = <0x0>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x0 0x4000000>;	/* 64 MiB */
			linux,cma-default;
		};
	};

	/* DDR frequency scaling through Rockchip's BL31 (ROCKNIX's
	 * 036-px30-dmc-devfreq): the loader leaves the DDR at 333 MHz */
	dfi: dfi@ff610000 {
		compatible = "rockchip,px30-dfi";
		reg = <0x0 0xff610000 0x0 0x400>;
		rockchip,pmu = <&pmugrf>;
	};

	dmc: dmc {
		compatible = "rockchip,px30-dmc";
		interrupts = <GIC_SPI 105 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "complete";
		devfreq-events = <&dfi>;
		operating-points-v2 = <&dmc_opp_table>;
		status = "disabled";
	};

	dmc_opp_table: opp-table-dmc {
		compatible = "operating-points-v2";

		opp-194000000 {
			opp-hz = /bits/ 64 <194000000>;
			opp-microvolt = <950000>;
		};

		opp-328000000 {
			opp-hz = /bits/ 64 <328000000>;
			opp-microvolt = <950000>;
		};

		opp-450000000 {
			opp-hz = /bits/ 64 <450000000>;
			opp-microvolt = <950000>;
		};

		opp-528000000 {
			opp-hz = /bits/ 64 <528000000>;
			opp-microvolt = <975000>;
		};

		opp-666000000 {
			opp-hz = /bits/ 64 <666000000>;
			opp-microvolt = <1050000>;
		};
	};
};

&display_subsystem {
	ports = <&vopb_out>;
};

/delete-node/ &dsi_in_vopl;
/delete-node/ &lvds_vopl_in;
/delete-node/ &vopl;
/delete-node/ &vopl_mmu;

&cpu0_opp_table {
	/delete-node/ opp-600000000;
	/delete-node/ opp-816000000;
	/delete-node/ opp-1200000000;

	opp-1416000000 {
		opp-hz = /bits/ 64 <1416000000>;
		opp-microvolt = <1350000 1350000 1350000>;
		clock-latency-ns = <40000>;
		turbo-mode;
	};
};

&gpu_opp_table {
	/delete-node/ opp-200000000;
	/delete-node/ opp-300000000;
	/delete-node/ opp-400000000;
	/delete-node/ opp-480000000;

	opp-560000000 {
		opp-hz = /bits/ 64 <560000000>;
		opp-microvolt = <1150000>;
	};
};

&gpu {
	clock-names = "bus";
	resets = <&cru SRST_GPU>;
	power_policy = "coarse_demand";

	power_model@0 {
		compatible = "arm,mali-simple-power-model";
		static-coefficient = <100000>;
		dynamic-coefficient = <953>;
		ts = <(-108890) 63610 (-1355) 20>;
		thermal-zone = "gpu-thermal";
	};

	power_model@1 {
		compatible = "arm,mali-g31-power-model";
		scale = <5>;
	};
};

&usb20_otg {
	usb-role-switch;
	role-switch-default-mode = "host";
};
