{
  "name": "zyperos-tour-video",
  "version": "0.1.0",
  "private": true,
  "description": "The ZyperOS tour video: the launcher's own frames, composed with Remotion.",
  "scripts": {
    "preview": "remotion studio",
    "render": "remotion render ZyperOSTour out/zyperos-tour-master.mp4",
    "poster": "remotion still Poster out/poster.png",
    "typecheck": "tsc --noEmit",
    "stills": "node scripts/stills.mjs",
    "stills:reddit": "STILLS_COMP=Reddit105 STILLS_TIMELINE=src/reddit/timeline.ts STILLS_OUT=out/reddit node scripts/stills.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
