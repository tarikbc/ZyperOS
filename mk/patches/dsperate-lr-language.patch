+// The DS language a game sees, 0 to 6 as the firmware's user settings number
+// them (6 is the iQue DS's Chinese), or -1 for the firmware's own. See
+// read_language and apply_language.
+constexpr const char* kLanguages[] = {"japanese", "english", "french", "german", "italian", "spanish", "chinese"};
+int ds_language = -1;
+// The firmware's own language, as the dump has it, read at the start: what
+// "firmware" puts back at a reset. -1 when the image has no user settings.
+int fw_language = -1;
 uint32_t frame[W * H * 2];
