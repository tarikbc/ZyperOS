+
+// The language, in this run's copy of the firmware: the user settings a game
+// is given at direct boot (setup_direct_boot) are copied from it. At the start
+// (boot, just after load_bios), and again before every reset's direct boot
+// (retro_reset): a reset does not load the firmware again, but the copy is
+// the game's to write while it runs (a game's own settings screen writes the
+// firmware's flash), and the option may have changed since the start. The
+// firmware file is never written: DSperate keeps the change as a dirty page
+// of its memory copy, which only its own frontends save (to a sidecar,
+// save_firmware_override), and this wrapper does not. Nothing else of the
+// settings (nickname, birthday, colour) or of the game's save is touched.
+void apply_language(bool start) {
+  ds::bios::UserSettings now;
+  const bool had = nds->read_user_settings(now);
+  if (start) fw_language = had && now.language < 7 ? now.language : -1;
+  if (!had) {
+    if (ds_language >= 0)
+      log(RETRO_LOG_WARN, "dsperate: this firmware has no user settings to set the language in\n");
+    return;
+  }
+  const int want = ds_language >= 0 ? ds_language : fw_language;
+  const bool same = want < 0 || now.language == want;
+  if (!same) {
+    ds::bios::UserSettings user;
+    user.language = static_cast<ds::u8>(want);
+    nds->write_user_settings(ds::NDS::UserField::Language, user);
+  }
+  if (start && ds_language >= 0)
+    log(RETRO_LOG_INFO, "dsperate: language %s (the firmware's was %s)\n", kLanguages[ds_language],
+        fw_language >= 0 ? kLanguages[fw_language] : "not known");
+  else if (!start && want >= 0)
+    log(RETRO_LOG_INFO, same ? "dsperate: reset, language %s\n"
+                             : "dsperate: reset, language %s again (the firmware copy had %s)\n",
+        kLanguages[want], now.language < 7 ? kLanguages[now.language] : "none");
 }
 
 bool boot() {
