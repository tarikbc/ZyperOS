diff --git a/src/libretro.cpp b/src/libretro.cpp
index 76eeee6..db4cf70 100644
--- a/src/libretro.cpp
+++ b/src/libretro.cpp
@@ -44,6 +44,10 @@ retro_log_printf_t         log_cb;
 std::unique_ptr<ds::NDS> nds;
 std::string rom_path;
 bool jit_on = true;
+// The DS language a game sees, 0 to 6 as the firmware's user settings number
+// them (6 is the iQue DS's Chinese), or -1 for the firmware's own. See read_options and boot.
+constexpr const char* kLanguages[] = {"japanese", "english", "french", "german", "italian", "spanish", "chinese"};
+int ds_language = -1;
 uint32_t frame[W * H * 2];
 ds::s16 audio[4096 * 2];
 size_t state_size;   // fixed for the session: libretro states are a fixed size
@@ -78,6 +82,16 @@ std::string dir(unsigned cmd) {
 void read_options() {
   retro_variable v{"dsperate_jit", nullptr};
   jit_on = !(env_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &v) && v.value && !std::strcmp(v.value, "disabled"));
+  // The language the game sees. A DS game reads it from the firmware's user
+  // settings, which a firmware.bin in the system directory brings from
+  // whichever console it was dumped from, whatever the frontend or its
+  // player speaks. "firmware", and anything not named here, leaves that
+  // alone.
+  retro_variable lv{"dsperate_language", nullptr};
+  ds_language = -1;
+  if (env_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &lv) && lv.value)
+    for (int i = 0; i < 7; ++i)
+      if (!std::strcmp(lv.value, kLanguages[i])) ds_language = i;
 }
 
 // Battery saves are the frontend's (RETRO_MEMORY_SAVE_RAM, a raw chip image,
@@ -237,6 +251,23 @@ bool boot() {
     log(RETRO_LOG_ERROR, "dsperate: bios: %s\n", err.c_str());
     return false;
   }
+  // The language, in this run's copy of the firmware: the user settings the
+  // game is given at direct boot (setup_direct_boot) are copied from it. The
+  // firmware file is never written: DSperate keeps the change as a dirty page
+  // of its memory copy, which only its own frontends save (to a sidecar,
+  // save_firmware_override), and this wrapper does not. Nothing else of the
+  // settings (nickname, birthday, colour) or of the game's save is touched.
+  if (ds_language >= 0) {
+    ds::bios::UserSettings user;
+    ds::bios::UserSettings was;
+    user.language = static_cast<ds::u8>(ds_language);
+    const bool had = nds->read_user_settings(was);
+    if (nds->write_user_settings(ds::NDS::UserField::Language, user))
+      log(RETRO_LOG_INFO, "dsperate: language %s (the firmware's was %s)\n", kLanguages[ds_language],
+          had && was.language < 7 ? kLanguages[was.language] : "not known");
+    else
+      log(RETRO_LOG_WARN, "dsperate: this firmware has no user settings to set the language in\n");
+  }
   nds->reset();
   if (!nds->load_rom(rom_path)) {
     log(RETRO_LOG_ERROR, "dsperate: %s: %s\n", rom_path.c_str(), nds->rom_error.c_str());
@@ -256,6 +287,7 @@ RETRO_API void retro_set_environment(retro_environment_t cb) {
   env_cb = cb;
   static const retro_variable vars[] = {
     {"dsperate_jit", "JIT recompiler (restart); enabled|disabled"},
+    {"dsperate_language", "Game language (restart); firmware|japanese|english|french|german|italian|spanish|chinese"},
     {nullptr, nullptr},
   };
   cb(RETRO_ENVIRONMENT_SET_VARIABLES, const_cast<retro_variable*>(vars));
