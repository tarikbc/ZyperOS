-static void context_reset() { ((LibretroHWRenderContext *)Libretro::ctx)->ContextReset(); }
-static void context_destroy() { ((LibretroHWRenderContext *)Libretro::ctx)->ContextDestroy(); }
+// ZyperOS: the frontend's context callbacks may come after retro_unload_game,
+// which deletes ctx and sets it to null. Diatom destroys a core's context
+// after retro_unload_game (flycast2021's emulation thread hung on Quit the
+// other way round), so every PSP quit called ContextDestroy on a null ctx
+// and the resident Diatom crashed at address 0, to be started again by the
+// launcher (1.0.5, 2026-11-13). With no ctx there is nothing left to destroy:
+// retro_unload_game has stopped the emulation thread and freed it all.
+static void context_reset() {
+	if (Libretro::ctx)
+		((LibretroHWRenderContext *)Libretro::ctx)->ContextReset();
+}
+static void context_destroy() {
+	if (Libretro::ctx)
+		((LibretroHWRenderContext *)Libretro::ctx)->ContextDestroy();
+}
 
