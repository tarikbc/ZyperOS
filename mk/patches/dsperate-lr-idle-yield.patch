++IdleYieldStats g_ystats;
++// The loop head a CPU met last, and its budget then: the same head again
++// with less budget left is the loop's next iteration in the same slice.
++u32 g_yhead[2] = {~0u, ~0u};
++s32 g_ybudget[2];
