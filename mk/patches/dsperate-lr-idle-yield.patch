++// A load the yield may let a CPU poll: plain memory, or I/O that does not
++// change by being read. The IPC receive FIFO and the gamecard's data port pop
++// a word on every read, so a loop reading them consumes what it reads.
++inline bool yield_safe_address(CpuContext& cpu, u32 addr) {
++  if (cpu.page_table.read_ptr(addr)) return true;
++  if ((addr & 0x0F000000u) != 0x04000000u) return false;
++  const u32 port = addr & 0x0FFFFFFCu;
++  return !(port >= 0x04100000u && port <= 0x0410001Cu);
++}
