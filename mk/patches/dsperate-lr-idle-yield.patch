++// One Thumb instruction of a candidate body, as scan_instr is for ARM: the
++// registers it reads and writes, its loads, and a rejection for anything
++// observable or that leaves the loop by another way than its back edge.
++bool scan_thumb(BodyScan& s, u32 at, u16 instr, u32 head, u32 tail) {
++  using arm::TOp;
++  const u32 rd = instr & 7, rs = (instr >> 3) & 7;
++  auto load = [&](u8 base, s32 offset, u32 addr, u8 index) {
++    if (s.load_count >= MAX_LOADS) return false;
++    LoadSite& site = s.loads[s.load_count++];
++    site.base = base; site.offset = offset; site.addr = addr; site.index = index;
++    return true;
++  };
++  switch (arm::decode_thumb(instr)) {
++  case TOp::ShiftImm:                       // LSL/LSR/ASR rd, rs, #imm5
++    if (((instr >> 11) & 3) == 0 && ((instr >> 6) & 0x1F) == 0) do_read(s, FLAGS);   // LSL #0 keeps C
++    do_read(s, rs); do_write(s, rd); do_write(s, FLAGS);
++    break;
++  case TOp::AddSubReg:                      // ADD/SUB rd, rs, rn
++    do_read(s, rs); do_read(s, (instr >> 6) & 7); do_write(s, rd); do_write(s, FLAGS);
++    break;
++  case TOp::AddSubImm3:
++    do_read(s, rs); do_write(s, rd); do_write(s, FLAGS);
++    break;
++  case TOp::MovCmpAddSubImm8: {
++    const u32 op = (instr >> 11) & 3, r = (instr >> 8) & 7;
++    if (op != 0) do_read(s, r);                     // MOV writes it fresh
++    if (op != 1) do_write(s, r);                    // CMP only compares
++    do_write(s, FLAGS);
++    break;
++  }
++  case TOp::Alu: {
++    const u32 op = (instr >> 6) & 0xF;
++    if (op == 0x8 || op == 0xA || op == 0xB) { do_read(s, rd); do_read(s, rs); do_write(s, FLAGS); break; }   // TST CMP CMN
++    if (op == 0x9 || op == 0xF) { do_read(s, rs); do_write(s, rd); do_write(s, FLAGS); break; }               // NEG MVN
++    if (op == 0x5 || op == 0x6 || op == 0x2 || op == 0x3 || op == 0x4 || op == 0x7) do_read(s, FLAGS);      // ADC SBC; a shift by 0 keeps C
++    do_read(s, rd); do_read(s, rs); do_write(s, rd); do_write(s, FLAGS);
++    break;
++  }
++  case TOp::HiRegOp: {
++    const u32 op = (instr >> 8) & 3, hd = (instr & 7) | ((instr >> 4) & 8), hs = (instr >> 3) & 0xF;
++    if (op == 1) { do_read(s, hd); do_read(s, hs); do_write(s, FLAGS); break; }   // CMP
++    if (hd == 15) return reject(IdleReject::PcWrite);
++    if (op == 0) do_read(s, hd);                                                   // ADD; MOV only reads hs
++    do_read(s, hs); do_write(s, hd);
++    break;
++  }
++  case TOp::LdrPcRel:
++    if (!load(0xFF, 0, ((at + 4) & ~2u) + (instr & 0xFFu) * 4u, 0xFF)) return false;
++    do_write(s, (instr >> 8) & 7);
++    break;
++  case TOp::LdrStrReg: {                    // STR STRH STRB | LDRSB LDR LDRH LDRB LDRSH
++    if (((instr >> 9) & 7) < 3) return reject(IdleReject::Store);
++    const u32 rm = (instr >> 6) & 7;
++    if (!load(static_cast<u8>(rs), 0, 0, static_cast<u8>(rm))) return false;
++    do_read(s, rs); do_read(s, rm); do_write(s, rd);
++    break;
++  }
++  case TOp::LdrStrImm5: {
++    if (!(instr & (1u << 11))) return reject(IdleReject::Store);
++    const s32 imm = static_cast<s32>((instr >> 6) & 0x1F) * ((instr & (1u << 12)) ? 1 : 4);
++    if (!load(static_cast<u8>(rs), imm, 0, 0xFF)) return false;
++    do_read(s, rs); do_write(s, rd);
++    break;
++  }
++  case TOp::LdrStrHImm5:
++    if (!(instr & (1u << 11))) return reject(IdleReject::Store);
++    if (!load(static_cast<u8>(rs), static_cast<s32>((instr >> 6) & 0x1F) * 2, 0, 0xFF)) return false;
++    do_read(s, rs); do_write(s, rd);
++    break;
++  case TOp::LdrStrSpRel:
++    if (!(instr & (1u << 11))) return reject(IdleReject::Store);
++    if (!load(13, static_cast<s32>(instr & 0xFF) * 4, 0, 0xFF)) return false;
++    do_read(s, 13); do_write(s, (instr >> 8) & 7);
++    break;
++  case TOp::AddPcSp:
++    if (instr & (1u << 11)) do_read(s, 13);
++    do_write(s, (instr >> 8) & 7);
++    break;
++  case TOp::AdjustSp:
++    do_read(s, 13); do_write(s, 13);   // a carried register: no poll
++    break;
++  case TOp::BCond: {
++    do_read(s, FLAGS);
++    const u32 target = at + 4 + static_cast<u32>(static_cast<s32>(static_cast<s8>(instr & 0xFF)) * 2);
++    if (at != tail || target != head) return reject(IdleReject::BadInstr);
++    break;
++  }
++  case TOp::B: {
++    const u32 target = at + 4 + static_cast<u32>((static_cast<s32>(static_cast<u32>(instr) << 21) >> 21) * 2);
++    if (at != tail || target != head) return reject(IdleReject::BadInstr);
++    break;
++  }
++  case TOp::PushPop: case TOp::StmLdm:
++    return reject(IdleReject::Store);   // a store, or a load that moves its base
++  default:
++    return reject(IdleReject::BadInstr);
++  }
++  return true;
++}
