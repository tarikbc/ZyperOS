++  if (g_yhead[c] != key || budget >= g_ybudget[c]) { g_yhead[c] = key; g_ybudget[c] = budget; return; }
++  g_yhead[c] = ~0u;
++  if (!g_idle_yield || budget < 0) return;
++  // An interrupt due now is taken at the next block; tracing and watchpoints
++  // see every instruction (as wait_loop_run).
++  if (cpu.hot.irq_pending && !(cpu.hot.cpsr & 0x80)) return;
++  if (cpu.nds->trace || cpu.step_limit || mem::Bus::watch_active()) return;
++  Verdict& v = g_ycache[c][cache_slot(head)];
++  if (!v.valid || v.pc != head || v.thumb != thumb || !v.skippable ||
++      body_checksum_mode(cpu, v.head, v.tail, thumb) != v.checksum) return;
++  for (u32 i = 0; i < v.load_count; ++i) {
++    const LoadSite& site = v.loads[i];
++    u32 addr = site.base == 0xFF ? site.addr : cpu.hot.regs[site.base] + static_cast<u32>(site.offset);
++    if (site.index != 0xFF) addr += cpu.hot.regs[site.index];
++    if (!yield_safe_address(cpu, addr)) { ++g_ystats.unsafe; return; }
++  }
++  cpu.hot.cycle_budget = -1;   // the rest of the slice, spent waiting
++  ++g_ystats.yields;
++}
