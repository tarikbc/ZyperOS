++// Idle-loop yield, one CPU at a time. A loop the recompiler translates as one
++// block that branches back to its own start, whose body has no side effect
++// (no store, no PSR write, no call, no load that pops) and carries no
++// register into the next iteration, is a poll: nothing it reads can change
++// until something outside this CPU acts, and outside changes come at slice
++// boundaries and events. So from its second iteration in a slice, that CPU
++// gives up the rest of the slice: its budget is spent, the other CPU runs its
++// own slice, the events fire, and the next slice's iteration sees whatever
++// changed. ARM and Thumb. Unlike in_idle_loop's skip, it needs neither the
++// other CPU idle nor a pending 3D swap, and it decides the shape once, at
++// translation.
++//
++// On by default; DS_IDLE_YIELD=0, or the frontend (a game that needs exact
++// polling), turns it off.
++extern bool g_idle_yield;
++
++// At translation: whether the block [head, tail], `tail` its back edge to
++// `head`, is such a loop. Cached per (head, mode).
++bool idle_yield_shape(CpuContext& cpu, u32 head, u32 tail, bool thumb);
++// The translated loop's hook, at its head each iteration: the slice given up
++// from the second iteration on, when every load reads plain memory or I/O
++// that does not change by being read.
++void idle_yield_run(CpuContext& cpu, u32 head, bool thumb);
++
++struct IdleYieldStats {
++  u64 shapes, rejects, calls, yields, unsafe;
++};
++const IdleYieldStats& idle_yield_stats();
++
