++u32 body_checksum_mode(CpuContext& cpu, u32 head, u32 tail, bool thumb) {
++  if (!thumb) return body_checksum(cpu, head, tail);
++  u32 sum = 0x9E3779B9u;
++  for (u32 at = head; at <= tail; at += 2) {
++    u16 instr;
++    if (!fetch16(cpu, at, instr)) return 0;
++    sum = (sum ^ instr) * 16777619u;
++  }
++  return sum ? sum : 1u;
++}
