++bool yield_analyse(CpuContext& cpu, u32 head, u32 tail, bool thumb, Verdict& v) {
++  v.pc = head; v.thumb = thumb; v.valid = true; v.skippable = false; v.load_count = 0;
++  const u32 step = thumb ? 2 : 4;
++  if (tail < head || (tail - head) / step + 1 > MAX_BODY) return reject(IdleReject::TooLong);
++  BodyScan s;
++  for (u32 at = head; at <= tail; at += step) {
++    if (thumb) {
++      u16 instr;
++      if (!fetch16(cpu, at, instr)) return reject(IdleReject::Fetch);
++      if (!scan_thumb(s, at, instr, head, tail)) return false;
++    } else {
++      u32 instr;
++      if (!fetch(cpu, at, instr)) return reject(IdleReject::Fetch);
++      if (!scan_instr(s, at, instr, head, tail)) return false;
++    }
++  }
++  // A register carried into the next iteration counts something: a delay
++  // loop, not a poll. A loop with no load at all is fine here: `b .`, or a
++  // spin on flags it does not change, waits for an interrupt.
++  if (s.written & s.read_before_write) return reject(IdleReject::Carried);
++  v.skippable = true;
++  v.head = head; v.tail = tail;
++  v.checksum = body_checksum_mode(cpu, head, tail, thumb);
++  v.load_count = s.load_count;
++  for (u32 i = 0; i < s.load_count; ++i) v.loads[i] = s.loads[i];
++  return true;
++}
