 #include <sys/socket.h>
 #include <sys/ioctl.h>
 #include <netinet/in.h>
+#include <netinet/tcp.h>
 #include <netdb.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/time.h>
+#endif
+
+#ifndef _WIN32
+/* ZyperOS (mk/patches/gambatte-link.patch): the link as two handhelds on
+ * Wi-Fi need it. A peer that goes away without closing (out of range, its
+ * battery out) left the side waiting for its answer blocked in read() until
+ * TCP gave up, a quarter of an hour, the game frozen; now each read and
+ * write waits at most LINK_IO_TIMEOUT_S, and a timeout is a cable pulled
+ * (0xFF to the game) and a new connection. Ten seconds is long enough for
+ * the other player to open their menu and come back, which pauses this
+ * side's game while it waits, and short enough not to look like a hang. */
+#define LINK_IO_TIMEOUT_S 10
+/* How often a lost connection is tried again, on a monotonic clock: it was
+ * five seconds of clock(), the process's CPU time, so up to half a minute on
+ * a handheld whose emulator uses a fifth of a core. */
+#define LINK_RETRY_MS 1000
+/* A connect to an address nobody answers (no ARP reply) blocked for seconds
+ * on the game's thread; now it waits this long. */
+#define LINK_CONNECT_MS 500
+
+static long long link_now_ms(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (long long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+/* No Nagle (two bytes each way per transfer), the timeouts above, and no
+ * SIGPIPE where the system has no MSG_NOSIGNAL */
+static void link_socket_setup(int fd)
+{
+	struct timeval tv;
+	int one = 1;
+
+	tv.tv_sec = LINK_IO_TIMEOUT_S;
+	tv.tv_usec = 0;
+	setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+	setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+	setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+#ifdef SO_NOSIGPIPE
+	setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
+#endif
+}
+
+#ifndef MSG_NOSIGNAL
+#define MSG_NOSIGNAL 0
+#endif
+
+/* Both bytes, or false: a write to a peer that has gone returns an error
+ * rather than raising SIGPIPE, which would end the emulator */
+static bool link_write2(int fd, const unsigned char *buf)
+{
+	size_t done = 0;
+
+	while (done < 2) {
+		ssize_t n = ::send(fd, (const char *)buf + done, 2 - done, MSG_NOSIGNAL);
+		if (n <= 0) {
+			if (n < 0 && errno == EINTR) continue;
+			return false;
+		}
+		done += (size_t)n;
+	}
+	return true;
+}
+
+/* Both bytes, or false: a closed peer (0), an error or the timeout. The two
+ * bytes can come in two segments, and the second was read as garbage. */
+static bool link_read2(int fd, unsigned char *buf)
+{
+	size_t done = 0;
+
+	while (done < 2) {
+		ssize_t n = ::recv(fd, (char *)buf + done, 2 - done, 0);
+		if (n <= 0) {
+			if (n < 0 && errno == EINTR) continue;
+			return false;
+		}
+		done += (size_t)n;
+	}
+	return true;
+}
 #endif
 
