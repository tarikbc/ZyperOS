# plastron's build runs this (its package/zyperos/zyperos.mk): CC is its
# cross-compiler, and SYSROOT its staging directory, which holds the same SDL2
# and FFmpeg the device's system is built with, so what links is what runs.
BUILD := build
# Every device shares src/*.c; DEVICE picks the one device file built with it.
DEVICE ?= brick
SRC := $(wildcard src/*.c) $(wildcard src/ds/*.c) src/device/$(DEVICE).c
CC ?= aarch64-linux-gnu-gcc

VERSION ?= 0.0
CFLAGS := -DZYPEROS_VERSION='"$(VERSION)"' -O2 -mcpu=cortex-a53 -Wall -Wextra -Wno-unused-parameter -std=gnu11 \
          -I$(SYSROOT)/usr/include/SDL2 -D_GNU_SOURCE
# No undefined symbols allowed, in this code or in the libraries it links:
# SYSROOT has SDL and everything SDL needs, so the link checks that ZyperOS uses
# no function the system's libraries lack, and that those libraries resolve.
LDFLAGS := -L$(SYSROOT)/usr/lib -Wl,-rpath-link,$(SYSROOT)/usr/lib
# liblzma for a CHD's LZMA hunks (src/chd.c): the system's, which FFmpeg
# already needs, so it costs the image nothing
LDLIBS := -lSDL2 -lSDL2_image -lSDL2_ttf -lsqlite3 -lz -llzma -lasound -lpthread -lm

# The ScreenScraper developer pair, from the environment into a GENERATED
# HEADER rather than onto the compile line.
#
# -DSS_DEVPASS='"..."' would work and would put the password in an argument
# make echoes on every build, into the terminal and into any log the build is
# piped to. The header goes under $(BUILD), which is gitignored, is written
# with a 077 umask, and is replaced only when its contents change so an
# unchanged environment does not force a relink.
#
# AN UNSET ENVIRONMENT IS A SUPPORTED BUILD. Both come out empty, ss_have_dev()
# is false, and the launcher scrapes from libretro alone - so a stranger
# cloning this repository gets a launcher that works. The credentials are never
# committed. That keeps them out of public repositories, where they are
# harvested; it is no secret from anyone holding a built card (src/ss.h).
CREDS := $(BUILD)/ss_creds.h
CFLAGS += -I$(BUILD)
# src too, so a device file in src/device/ includes the shared headers by name
CFLAGS += -Isrc

.PHONY: creds
creds:
	@mkdir -p $(BUILD)
	@umask 077; { \
	  echo '/* Generated by the build from the environment. Not in the'; \
	  echo '   repository, and not a secret from anyone holding the card:'; \
	  echo '   see src/ss.h. */'; \
	  printf '#define SS_DEVID   "%s"\n' "$$(printf '%s' "$$SS_DEVID"   | sed 's/[\\"]/\\\\&/g')"; \
	  printf '#define SS_DEVPASS "%s"\n' "$$(printf '%s' "$$SS_DEVPASS" | sed 's/[\\"]/\\\\&/g')"; \
	} > $(CREDS).new
	@cmp -s $(CREDS).new $(CREDS) 2>/dev/null || mv -f $(CREDS).new $(CREDS)
	@rm -f $(CREDS).new

# The device file's own headers too: src/device/pixel2_levels.h is the volume
# and backlight ladders, which portkeys shares.
$(BUILD)/zyperos.elf: $(SRC) $(CREDS) $(wildcard src/*.h) $(wildcard src/ds/*.h) $(wildcard src/device/*.h)
	mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(SRC) $(LDLIBS)

# Muse, the engine of MP4 (the media player, once the audio player Muse): a
# second binary, not part of zyperos.elf - SRC above is src/*.c, which does not
# descend into src/muse/. Linked against the FFmpeg and ALSA in SYSROOT;
# swscale for the odd video whose pictures are not 8-bit 4:2:0 (src/muse/vid.c),
# and src/mp4frame.h, the pictures' shared layout, is the launcher's too.
MUSE_SRC := $(wildcard src/muse/*.c)
$(BUILD)/muse: $(MUSE_SRC) $(wildcard src/muse/*.h) src/mp4frame.h src/monoclock.h
	mkdir -p $(BUILD)
	$(CC) -O2 -mcpu=cortex-a53 -Wall -Wextra -Wno-unused-parameter -std=gnu11 \
	      -D_GNU_SOURCE -I$(SYSROOT)/usr/include $(LDFLAGS) -o $@ $(MUSE_SRC) \
	      -lavformat -lavcodec -lavfilter -lswscale -lswresample -lavutil -lasound -lpthread -lm

# p2d, NES player 2's server (src/p2d/main.c): a program of its own beside
# the launcher, started by it for a game with a guest, so the network is on
# neither the game's thread nor the launcher's loop. SRC above does not
# descend into src/p2d/; the launcher's httpd and captive.c are linked in
# again, and zlib for the frames.
P2D_SRC := $(wildcard src/p2d/*.c) src/httpd.c src/captive.c
$(BUILD)/p2d: $(P2D_SRC) $(wildcard src/p2d/*.h) src/httpd.h src/captive.h src/p2share.h \
              src/monoclock.h src/xfer.h
	mkdir -p $(BUILD)
	$(CC) -O2 -mcpu=cortex-a53 -Wall -Wextra -Wno-unused-parameter -std=gnu11 \
	      -D_GNU_SOURCE -I$(SYSROOT)/usr/include $(LDFLAGS) -o $@ $(P2D_SRC) -lz

# Registers a do-nothing media player with BlueZ so a headset's absolute
# volume is not dropped, and hands a headset's keys to Muse; see the file.
# Linked against SYSROOT's libdbus, whose arch header lives under lib.
# The Pixel 2's volume keys while a port runs, ZyperOS and Diatom being
# stopped then, and the volume bar over the port (tools/portkeys.c, started by
# launch.sh). The launcher's key repeat and level rules (tools/pkkeys.c), and its bar, its theme rule
# (src/theme.c, for Auto's hours) and the theme file the bar falls back on,
# Date & Time's zone list (src/clock.c), the settings it reads for the bar
# (tools/pkset.c) and SQLite for them, the side lights' line for a level
# (src/sidelights.c), and the heat warning's rules (src/heat.c); no SDL. The bar's colors are src/design.h's,
# which osdbar.h, theme.h and themefile.h include, so it is listed beside
# them: a token changed there rebuilds this. The string tables (src/i18n.h)
# because those files name their rows' words through them; read-only data
# with no relocations, so portkeys pays file size, not memory or start time.
PORTKEYS_SRC := tools/portkeys.c tools/pkkeys.c tools/pkset.c src/audioout.c src/osdbar.c src/theme.c \
                src/themefile.c src/look.c src/clock.c src/sidelights.c src/i18n.c src/i18n_tables.c src/heat.c
$(BUILD)/portkeys: $(PORTKEYS_SRC) tools/pkkeys.h src/keyrepeat.h tools/pkset.h src/osdbar.h src/theme.h src/themefile.h \
                   src/clock.h src/design.h src/look.h src/audioout.h src/device/pixel2_levels.h src/sidelights.h \
                   src/heat.h src/portmenu.h
	mkdir -p $(BUILD)
	$(CC) -O2 -mcpu=cortex-a53 -Wall -Wextra -std=gnu11 -Isrc -I$(SYSROOT)/usr/include \
	      $(LDFLAGS) -o $@ $(PORTKEYS_SRC) -lsqlite3 -lm

# MENU+START held a second, back to the home from anything (tools/zyhome.c),
# run by launch.sh beside everything
$(BUILD)/zyhome: tools/zyhome.c tools/zychord.h src/ctl.c src/ctl.h
	mkdir -p $(BUILD)
	$(CC) -O2 -mcpu=cortex-a53 -Wall -Wextra -std=gnu11 -Isrc $(LDFLAGS) -o $@ tools/zyhome.c src/ctl.c

$(BUILD)/btplayer: tools/btplayer.c
	mkdir -p $(BUILD)
	$(CC) -O2 -mcpu=cortex-a53 -Wall -Wextra -std=gnu11 \
	      -I$(SYSROOT)/usr/include/dbus-1.0 -I$(SYSROOT)/usr/lib/dbus-1.0/include \
	      $(LDFLAGS) -o $@ $< -ldbus-1

# System Update (update/, docs/updates.md): the release list's signature and
# every file's SHA-256 with the system's OpenSSL, the download with its
# libcurl (ranges, one connection kept open), the pack's members with zlib.
# A program of its own, beside the launcher, so a download goes on when the
# player leaves the screen. The version is the launcher's, for its User-Agent.
# No format-truncation warnings: every path is bounded well inside PATH_MAX
# (update/main.c, main), which GCC cannot see through snprintf.
UPDATE_SRC := update/main.c update/manifest.c update/status.c update/slots.c
$(BUILD)/zyperos-update: $(UPDATE_SRC) update/update.h
	mkdir -p $(BUILD)
	$(CC) -O2 -mcpu=cortex-a53 -Wall -Wextra -Wno-unused-parameter -Wno-format-truncation -std=gnu11 -D_GNU_SOURCE \
	      -DZYPEROS_VERSION='"$(VERSION)"' -I$(SYSROOT)/usr/include \
	      $(LDFLAGS) -o $@ $(UPDATE_SRC) -lcurl -lcrypto -lz
