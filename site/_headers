# Cloudflare Pages headers for zyperos.com; mk/site.sh copies this file into
# the build. The screenshots, the 3D model and its script keep their names
# when they change, so a day, served stale for a week while it refreshes. The
# icons, the manifest and the social card live at names browsers and crawlers
# look up by convention, so a week. HTML keeps the platform default, so an
# edit is live at once.

/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/models/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/pixel2.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
# The blog's style sheet and script: their links carry ?v= of the content
# (mk/blog.py), so a change is a new address and a year is safe
/blog.css
  Cache-Control: public, max-age=31536000, immutable
/blog.js
  Cache-Control: public, max-age=31536000, immutable
/blog/feed.xml
  Content-Type: application/rss+xml; charset=utf-8

/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon-96.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/og.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=604800

# The project's own pages.dev name serves the same page as zyperos.com; only
# zyperos.com goes in search results (branch previews are noindex already).
https://zyperos.pages.dev/*
  X-Robots-Tag: noindex
